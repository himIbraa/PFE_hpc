<https://legal.dz/resource/constitution/2020-11-01/2020#art_126_condition_0_dc471d50> a dznorm:Condition ;
    dznorm:conditionText "كل نائب أو عضو مجلس الأمة لا يستوفي شروط قابلية انتخابه أو يفقدها"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/constitution/2020-11-01/2020#art_126> ;
