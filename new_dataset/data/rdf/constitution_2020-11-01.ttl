    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "المادة 174" ;
    dzdoc:position 171 ;
    dzdoc:usesTerm dzterm:judge,
        dzterm:litigant .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_200> a dzdoc:Article ;
