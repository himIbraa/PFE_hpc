<https://legal.dz/resource/constitution/2020-11-01/2020#version_art_198> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا قررت المحكمة الدستورية عدم دستورية معاهدة أو اتفاق أو اتفاقية ، فلا يتم التصديق عليها . إذا قررت المحكمة الدستورية عدم دستورية قانون ، لا يتم إصداره . إذا قررت المحكمة الدستورية عدم دستورية أمر أو تنظيم ، فإن هذا النص يفقد أثره، ابتداء من يوم صدور قرار المحكمة الدستورية . إذا قررت المحكمة الدستورية أن نصا تشريعيا أو تنظيميا غير دستوري على أساس المادة 195 أعلاه ، يفقد أثره ابتداء من اليوم الذي يحدده قرار المحكمة الدستورية . تكون قرارات المحكمة الدستورية نهائية وملزمة لجميع السلطات العمومية وا"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_198_20201101_OpEnact_95038f09c2> ;
    dzdoc:replacementText "إذا قررت المحكمة الدستورية عدم دستورية معاهدة أو اتفاق أو اتفاقية ، فلا يتم التصديق عليها . إذا قررت المحكمة الدستورية عدم دستورية قانون ، لا يتم إصداره . إذا قررت المحكمة الدستورية عدم دستورية أمر أو تنظيم ، فإن هذا النص يفقد أثره، ابتداء من يوم صدور قرار المحكمة الدستورية . إذا قررت المحكمة الدستورية أن نصا تشريعيا أو تنظيميا غير دستوري على أساس المادة 195 أعلاه ، يفقد أثره ابتداء من اليوم الذي يحدده قرار المحكمة الدستورية . تكون قرارات المحكمة الدستورية نهائية وملزمة لجميع السلطات العمومية والسلطات الإدارية والقضائية"@ar ;
