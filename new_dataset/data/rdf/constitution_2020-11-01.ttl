<https://legal.dz/resource/constitution/2020-11-01/2020#art_158> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثالث__تنظيم_السلطات_والفصل_بينها_sec_الثالث__البرلمان> ;
    dzdoc:eId "art_158" ;
    dzdoc:fullText "يمكن أعضاء البرلمان أن يوجهوا أي سؤال شفوي أو كتابي إلى أي عضو في الحكومة . يكون الجواب عن السؤال الكتابي كتابيا خلال أجل أقصاه ثلاثون (30) يوما . بالنسبة للأسئلة الشفوية، يجب ألا يتعدى أجل الجواب ثلاثين (30) يوما . يعقد كل من المجلس الشعبي الوطني و مجلس الأمة ، بالتداول، جلسة أسبوعية تخصص لأجوبة الحكومة على الأسئلة الشفوية للنواب وأعضاء مجلس الأمة . إذا رأت أي من الغرفتين أن جواب عضو الحكومة ، شفويا كان أو كتابيا، يبرر إجراء مناقشة ، تجري المناقشة حسب الشروط التي ينص عليها النظام الداخلي لـ المجلس الشعبي الوطني و مجلس الأمة . تنشر الأسئلة والأجوبة طبقا للشروط التي يخضع لها نشر محاضر مناقشات البرلمان ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/2020-11-01/2020#art_158_permission_0_045869cf> ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-11-01/2020#art_158_right_0_d52d66c9> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_158> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_158_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_158_para_1>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_158_para_2>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_158_para_3>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_158_para_4>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_158_para_5> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_158_20201101_OpEnact_b2a6590005> ;
