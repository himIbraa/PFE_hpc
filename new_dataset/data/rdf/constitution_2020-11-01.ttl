        <https://legal.dz/resource/constitution/2020-11-01/2020#art_162> ;
    dzdoc:referencesInternal <https://legal.dz/resource/constitution/2020-11-01/2020#art_106>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_111>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_158>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_160>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_161>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_162> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/2020-11-01/2020#art_115_condition_0_b2aca171> ;
    dzdoc:usesTerm dzterm:apn,
        dzterm:oversight,
        dzterm:parliament .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_133> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثالث__تنظيم_السلطات_والفصل_بينها_sec_الثالث__البرلمان> ;
    dzdoc:eId "art_133" ;
    dzdoc:fullText "تبتدئ الفترة التشريعية، وجوبا، في اليوم الخامس عشر (15) الذي يلي تاريخ إعلان المحكمة الدستورية النتائج ، تحت رئاسة أكبر النواب سنا، وبمساعدة أصغر نائبين منهم. ينتخب المجلس الشعبي الوطني مكتبه ويشكل لجانه. تطبق الأحكام السابقة الذكر على مجلس الأمة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_133> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_133_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_133_para_1>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_133_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_133_20201101_OpEnact_f0b2ce3ece> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-11-01/2020#art_133_obligation_0_f1245817> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "المادة 133" ;
    dzdoc:position 131 ;
    dzdoc:usesTerm dzterm:apn,
        dzterm:constitutional_court,
        dzterm:council_of_nation .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_175> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثالث__تنظيم_السلطات_والفصل_بينها_sec_الرابع__القضاء> ;
    dzdoc:eId "art_175" ;
    dzdoc:fullText "الحق في الدفاع معترف به . الحق في الدفاع مضمون في القضايا الجزائية ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-11-01/2020#art_175_right_0_1fb9a7f8>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_175_right_1_8ef87a6f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_175> ;
