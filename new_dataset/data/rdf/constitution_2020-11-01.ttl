    dznorm:provisionText "يخضع القانون العضوي، قبل إصداره، لمراقبة مطابقته للدستور من طرف المحكمة الدستورية"@ar ;
    dznorm:sourceArticle "art_140" .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_140_para_0> a dzdoc:Paragraph ;
