    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثالث__تنظيم_السلطات_والفصل_بينها_sec_الرابع__القضاء> ;
    dzdoc:eId "art_179" ;
    dzdoc:fullText "تمثل المحكمة العليا الهيئة المقومة لأعمال المجالس القضائية والمحاكم. يمثل مجلس الدولة الهيئة المقومة لأعمال المحاكم الإدارية للاستئناف والمحاكم الإدارية والجهات الأخرى الفاصلة في المواد الإدارية. تضمن المحكمة العليا و مجلس الدولة توحيد الاجتهاد القضائي في جميع أنحاء البلاد، ويسهران على احترام القانون. تفصل محكمة التنازع في حالات تنازع الاختصاص بين هيئات القضاء العادي وهيئات القضاء الإداري. يحدد قانون عضوي تنظيم المحكمة العليا و مجلس الدولة و محكمة التنازع ، وسيرها واختصاصاتها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_179> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/constitution/2020-11-01/2020#art_179_defocc_15add85dc4a7>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_179_defocc_f0bcca442424> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_179_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_179_para_1>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_179_para_2>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_179_para_3>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_179_para_4> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_179_20201101_OpEnact_c9677f0b65> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-11-01/2020#art_179_obligation_0_d3b77d4f>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_179_obligation_1_24ba5e91> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
