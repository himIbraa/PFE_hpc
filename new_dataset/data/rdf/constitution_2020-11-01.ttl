<https://legal.dz/resource/constitution/2020-11-01/2020#version_art_100> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا وقع عدوان فعلي على البلاد أو يوشك أن يقع حسبما نصت عليه الترتيبات الملائمة لميثاق الأمم المتحدة ، يعلن رئيس الجمهورية الحرب، بعد اجتماع مجلس الوزراء والاستماع إلى المجلس الأعلى للأمن واستشارة رئيس مجلس الأمة ورئيس المجلس الشعبي الوطني ورئيس المحكمة الدستورية . يجتمع البرلمان وجوبا. يوجه رئيس الجمهورية خطابا للأمة يعلمها بذلك."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_100_20201101_OpEnact_28bd6a5eff> ;
    dzdoc:replacementText "إذا وقع عدوان فعلي على البلاد أو يوشك أن يقع حسبما نصت عليه الترتيبات الملائمة لميثاق الأمم المتحدة ، يعلن رئيس الجمهورية الحرب، بعد اجتماع مجلس الوزراء والاستماع إلى المجلس الأعلى للأمن واستشارة رئيس مجلس الأمة ورئيس المجلس الشعبي الوطني ورئيس المحكمة الدستورية . يجتمع البرلمان وجوبا. يوجه رئيس الجمهورية خطابا للأمة يعلمها بذلك."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/constitution/2020-11-01/2020#art_100> ;
    dzdoc:sourceDocument <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:targetArticle <https://legal.dz/resource/constitution/2020-11-01/2020#art_100> ;
    dzdoc:targetDocument <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:targetScope "whole_article" ;
