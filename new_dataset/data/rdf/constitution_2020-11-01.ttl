<https://legal.dz/resource/constitution/2020-11-01/2020#art_45> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثاني__الحقوق_الأساسية_والحريات_العامة_والواجبات_sec_الأول__الحقوق_الأساسية_و_الحريات_العامة> ;
    dzdoc:eId "art_45" ;
    dzdoc:fullText "يخضع التوقيف للنظر في مجال التحريات الجزائية للرقابة القضائية ، و لا يمكن أن يتجاوز مدة ثمان وأربعين (48) ساعة . يملك الشخص الذي يوقف للنظر حق الاتصال فورا بأسرته . يجب إعلام الشخص الذي يوقف للنظر بحقه أيضا في الاتصال بمحاميه ، و يمكن القاضي أن يحد من ممارسة هذا الحق في إطار ظروف استثنائية ينص عليها القانون . لا يمكن تمديد مدة التوقيف للنظر، إلا استثناء، ووفقا للشروط المحددة بالقانون . عند انتهاء مدة التوقيف للنظر، يجب أن يجرى فحص طبي على الشخص الموقوف، إن طلب ذلك ، على أن يعلم بهذه الإمكانية، في كل الحالات. يخضع القصر إجباريا لفحص طبي . يحدد القانون كيفيات تطبيق هذه المادة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/2020-11-01/2020#art_45_permission_0_998c2a8c>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_45_permission_1_d0da6f55> ;
