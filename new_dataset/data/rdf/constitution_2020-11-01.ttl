    dznorm:conditionText "بعد أن يصوت المجلس الشعبي الوطني ومجلس الأمة على المبادرة بنفس الصيغة حسب الشروط نفسها التي تطبق على نص تشريعي"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/constitution/2020-11-01/2020#art_219> ;
    dznorm:position 0 .

