    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:versionText "القضاء سلطة مستقلة. القاضي مستقل، لا يخضع إلا للقانون ."@ar .

<https://legal.dz/resource/constitution/2020-11-01/2020#version_art_164_20201101_OpEnact_725b34e4c9> a dzdoc:ArticleVersion ;
