<https://legal.dz/resource/constitution/2020-11-01/2020#version_art_103> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في حال أسفرت الانتخابات التشريعية عن أغلبية رئاسية ، يقود الحكومة وزير أول . في حال أسفرت الانتخابات التشريعية عن أغلبية برلمانية ، يقود الحكومة رئيس حكومة . تتكون الحكومة من الوزير الأول أو رئيس الحكومة ، حسب الحالة، ومن الوزراء الذين يشكلونها."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_103_20201101_OpEnact_8ddd1da2f6> ;
    dzdoc:replacementText "في حال أسفرت الانتخابات التشريعية عن أغلبية رئاسية ، يقود الحكومة وزير أول . في حال أسفرت الانتخابات التشريعية عن أغلبية برلمانية ، يقود الحكومة رئيس حكومة . تتكون الحكومة من الوزير الأول أو رئيس الحكومة ، حسب الحالة، ومن الوزراء الذين يشكلونها."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/constitution/2020-11-01/2020#art_103> ;
