<https://legal.dz/resource/constitution/2020-11-01/2020#version_art_130> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن أن يكون عضو البرلمان محل متابعة قضائية عن الأعمال غير المرتبطة بمهامه البرلمانية بعد تنازل صريح من المعني عن حصانته . وفي حال عدم التنازل عن الحصانة ، يمكن جهات الإخطار إخطار المحكمة الدستورية لاستصدار قرار بشأن رفع الحصانة من عدمها."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_130_20201101_OpEnact_393b43816a> ;
