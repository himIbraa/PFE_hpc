<https://legal.dz/resource/constitution/2020-11-01/2020#art_115> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثالث__تنظيم_السلطات_والفصل_بينها_sec_الثالث__البرلمان> ;
    dzdoc:eId "art_115" ;
    dzdoc:fullText "يراقب البرلمان عمل الحكومة وفقا لـ الشروط المحددة في المواد 106 و 111 و 158 و 160 من الدستور . يمارس المجلس الشعبي الوطني الرقابة المنصوص عليها في المادتين 161 و 162 من الدستور."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_115> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_115_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_115_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_115_20201101_OpEnact_728d23319e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-11-01/2020#art_115_obligation_0_210b9d09> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "المادة 115" ;
    dzdoc:position 114 ;
    dzdoc:references <https://legal.dz/resource/constitution/2020-11-01/2020#art_106>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_111>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_158>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_160>,
