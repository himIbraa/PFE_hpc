<https://legal.dz/resource/constitution/2020-11-01/2020#art_162> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثالث__تنظيم_السلطات_والفصل_بينها_sec_الثالث__البرلمان> ;
    dzdoc:eId "art_162" ;
    dzdoc:fullText "تتم الموافقة على ملتمس الرقابة بتصويت أغلبية ثلثي (3/2) النواب . لا يتم التصويت إلا بعد ثلاثة (3) أيام من تاريخ إيداع ملتمس الرقابة . إذا صادق المجلس الشعبي الوطني على ملتمس الرقابة ، يقدم الوزير الأول أو رئيس الحكومة ، حسب الحالة، استقالة الحكومة إلى رئيس الجمهورية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_162> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_162_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_162_para_1>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_162_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_162_20201101_OpEnact_2158ff89b0> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-11-01/2020#art_162_obligation_0_cb02cf32> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "162" ;
    dzdoc:position 159 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/2020-11-01/2020#art_162_condition_0_2d541c44>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_162_condition_1_a4307df0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_162_condition_2_3bc3553a> ;
    dzdoc:usesTerm dzterm:apn,
        dzterm:government,
        dzterm:head_gov,
        dzterm:president,
        dzterm:prime_minister .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_172> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثالث__تنظيم_السلطات_والفصل_بينها_sec_الرابع__القضاء> ;
    dzdoc:eId "art_172" ;
    dzdoc:fullText "قاضي الحكم غير قابل للنقل إلا ضمن الشروط المحددة في الفقرة الثانية أدناه . لا يعزل القاضي ، ولا يمكن إيقافه عن العمل أو إعفاؤه أو تسليط عقوبة تأديبية عليه أثناء ممارسة مهامه أو بمناسبتها، إلا في الحالات وطبق الضمانات التي يحددها القانون بموجب قرار معلل من المجلس الأعلى للقضاء . يخطر القاضي المجلس الأعلى للقضاء في حالة تعرضه لأي مساس باستقلاليته. تحمي الدولة القاضي وتجعله في منأى عن الاحتياج . يحدد قانون عضوي كيفيات تطبيق هذه المادة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/2020-11-01/2020#art_172_permission_0_fe1dc647> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_172> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_172_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_172_para_1>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_172_para_2>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_172_para_3>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_172_para_4> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_172_20201101_OpEnact_fcefb6212d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-11-01/2020#art_172_obligation_0_da4a629a> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "المادة 172" ;
    dzdoc:position 169 ;
    dzdoc:references <https://legal.dz/resource/constitution/2020-11-01/2020#art_172> ;
    dzdoc:referencesInternal <https://legal.dz/resource/constitution/2020-11-01/2020#art_172> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/2020-11-01/2020#art_172_condition_0_49f18588>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_172_condition_1_0d093ef9> ;
    dzdoc:usesTerm dzterm:judge,
        dzterm:trial_judge .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_24> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثالث__الدولة> ;
    dzdoc:eId "art_24" ;
    dzdoc:fullText "يحظر استحداث أي منصب عمومي أو القيام بأي طلب عمومي لا يستهدف تحقيق المصلحة العامة . لا يمكن أن تكون الوظائف والعهدات في مؤسسات الدولة مصدرا للثراء، ولا وسيلة لخدمة المصالح الخاصة. يجب على كل عون عمومي ، في إطار ممارسة مهامه، تفادي أي حالة من حالات تعارض المصالح . يجب على كل شخص يعين في وظيفة عليا في الدولة، أو ينتخب أو يعين في البرلمان، أو في هيئة وطنية، أو ينتخب في مجلس محلي، التصريح بممتلكاته في بداية وظيفته أو عهدته وفي نهايتها . يحدد القانون كيفيات تطبيق هذه الأحكام."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/2020-11-01/2020#art_24_permission_0_e6c5e00f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_24> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_24_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_24_para_1>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_24_para_2>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_24_para_3>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_24_para_4> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_24_20201101_OpEnact_20538cb646> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-11-01/2020#art_24_obligation_0_053e4ded>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_24_obligation_1_2195ae44>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_24_obligation_2_49daf5f2> ;
