<https://legal.dz/resource/constitution/2020-11-01/2020#version_art_84> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجسد رئيس الجمهورية ، رئيس الدولة، وحدة الأمة، ويسهر في كل الظروف على وحدة التراب الوطني والسيادة الوطنية. يحمي الدستور ويسهر على احترامه. يجسد الدولة داخل البلاد وخارجها. له أن يخاطب الأمة مباشرة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
