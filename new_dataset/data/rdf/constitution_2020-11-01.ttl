<https://legal.dz/resource/constitution/2020-11-01/2020#version_art_44> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يتابع أحد، ولا يوقف أو يحتجز، إلا ضمن الشروط المحددة بالقانون، وطبقا للأشكال التي نص عليها . يتعين إعلام كل شخص موقوف بأسباب توقيفه . الحبس المؤقت إجراء استثنائي، يحدد القانون أسبابه ومدته وشروط تمديده. يعاقب القانون على أعمال وأفعال الاعتقال التعسفي."@ar ;
