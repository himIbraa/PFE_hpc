<https://legal.dz/resource/constitution/2020-11-01/2020#art_204> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:definesTerm dzterm:high_authority_transparency ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الرابع__مؤسسات_الرقابة_sec_الرابع__السلطة_العليا_للشفافية_والوقاية_من_الفساد_ومكافحته> ;
    dzdoc:eId "art_204" ;
    dzdoc:fullText "السلطة العليا للشفافية والوقاية من الفساد ومكافحته مؤسسة مستقلة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_204> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/constitution/2020-11-01/2020#art_204_defocc_44a20e660fad> ;
