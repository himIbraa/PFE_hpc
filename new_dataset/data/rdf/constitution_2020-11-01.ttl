<https://legal.dz/resource/constitution/2020-11-01/2020#version_art_30> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تنتظم الطاقة الدفاعية للأمة، ودعمها، وتطويرها، حول الجيش الوطني الشعبي. تتمثل المهمة الدائمة للجيش الوطني الشعبي في المحافظة على الاستقلال الوطني، والدفاع عن السيادة الوطنية . كما يضطلع بالدفاع عن وحدة البلاد، وسلامتها الترابية، وحماية مجالها البري والجوي والبحري. يتولى الجيش الوطني الشعبي الدفاع عن المصالح الحيوية والاستراتيجية للبلاد طبقا لأحكام الدستور."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_30_20201101_OpEnact_8cdca0cc93> ;
    dzdoc:replacementText "تنتظم الطاقة الدفاعية للأمة، ودعمها، وتطويرها، حول الجيش الوطني الشعبي. تتمثل المهمة الدائمة للجيش الوطني الشعبي في المحافظة على الاستقلال الوطني، والدفاع عن السيادة الوطنية . كما يضطلع بالدفاع عن وحدة البلاد، وسلامتها الترابية، وحماية مجالها البري والجوي والبحري. يتولى الجيش الوطني الشعبي الدفاع عن المصالح الحيوية والاستراتيجية للبلاد طبقا لأحكام الدستور."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/constitution/2020-11-01/2020#art_30> ;
