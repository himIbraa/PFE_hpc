    dzdoc:number "179" ;
    dzdoc:position 176 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/2020-11-01/2020#art_179_condition_0_6d02012d> ;
    dzdoc:usesTerm dzterm:conflict_tribunal,
        dzterm:council_of_state,
        dzterm:supreme_court .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_183> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثالث__تنظيم_السلطات_والفصل_بينها_sec_الرابع__القضاء> ;
    dzdoc:eId "art_183" ;
    dzdoc:fullText "تختص المحكمة العليا للدولة بالنظر في الأفعال التي يمكن تكييفها خيانة عظمى، والتي يرتكبها رئيس الجمهورية أثناء ممارسة عهدته. تختص المحكمة العليا للدولة بالنظر في الجنايات والجنح التي يرتكبها الوزير الأول ورئيس الحكومة بمناسبة تأدية مهامهما. يحدد قانون عضوي تشكيلة المحكمة العليا للدولة وتنظيمها وسيرها وكذلك الإجراءات المطبقة أمامها"@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/2020-11-01/2020#art_183_permission_0_6fa732ea> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_183> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_183_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_183_para_1>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_183_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_183_20201101_OpEnact_39427fe3b1> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-11-01/2020#art_183_obligation_0_6fa732ea>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_183_obligation_1_dfaabf1f> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "183" ;
    dzdoc:position 180 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/2020-11-01/2020#art_183_condition_0_03294f9a> ;
    dzdoc:usesTerm dzterm:high_court_state .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_49> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثاني__الحقوق_الأساسية_والحريات_العامة_والواجبات_sec_الأول__الحقوق_الأساسية_و_الحريات_العامة> ;
    dzdoc:eId "art_49" ;
    dzdoc:fullText "يحق لكل مواطن يتمتع بحقوقه المدنية والسياسية، أن يختار بحرية موطن إقامته، وأن يتنقل بحرية عبر التراب الوطني . لكل مواطن الحق في الدخول إلى التراب الوطني والخروج منه . لا يمكن تقييد هذه الحقوق إلا لمدة محددة، وبموجب قرار معلل من السلطة القضائية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/2020-11-01/2020#art_49_permission_0_70666074> ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-11-01/2020#art_49_right_0_36e889d0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_49_right_1_c2fa1427> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_49> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_49_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_49_para_1>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_49_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_49_20201101_OpEnact_29cc6b6946> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "49" ;
    dzdoc:position 48 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/2020-11-01/2020#art_49_condition_0_4589f852> .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_71> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثاني__الحقوق_الأساسية_والحريات_العامة_والواجبات_sec_الأول__الحقوق_الأساسية_و_الحريات_العامة> ;
    dzdoc:eId "art_71" ;
    dzdoc:fullText "تحظى الأسرة بحماية الدولة. حقوق الطفل محمية من طرف الدولة والأسرة مع مراعاة المصلحة العليا للطفل. تحمي وتكفل الدولة الأطفال المتخلى عنهم أو مجهولي النسب . تحت طائلة المتابعات الجزائية، يلزم الأولياء بضمان تربية أبنائهم . تحت طائلة المتابعات الجزائية، يلزم الأبناء بواجب القيام بالإحسان إلى أوليائهم ومساعدتهم . يعاقب القانون كل أشكال العنف ضد الأطفال واستغلالهم والتخلي عنهم. تسعى الدولة إلى ضمان المساعدة والحماية للمسنين."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-11-01/2020#art_71_right_0_eaf2ca54> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_71> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_71_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_71_para_1>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_71_para_2>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_71_para_3>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_71_para_4>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_71_para_5>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_71_para_6> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_71_20201101_OpEnact_d750420e3b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-11-01/2020#art_71_obligation_0_86e4e736>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_71_obligation_1_4e753c7a>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_71_obligation_2_f66d8fb7> ;
