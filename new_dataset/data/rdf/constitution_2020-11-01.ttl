<https://legal.dz/resource/constitution/2020-11-01/2020#art_91_obligation_0_9f44794b_ref_f0049a66f9c7> a dzdoc:ExternalReference,
        dzdoc:Reference ;
    rdfs:label "الدستور"@ar ;
    dzdoc:frbrUri "/akn/dz/act/constitution/2020-12-30/1"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/constitution/2020-12-30/1"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/constitution/2020-12-30/1" ;
    dzdoc:referencesTarget <https://legal.dz/resource/constitution/2020-12-30/1> ;
    dzdoc:resolutionReason "canonical_akn_path" ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceEId "art_91" ;
    dzdoc:sourceElementType "obligation" ;
    dzdoc:sourceTextSpan "يضطلع رئيس الجمهورية، بالإضافة إلى السلطات التي تخولها إياه صراحة أحكام أخرى في الدستور، بالسلطات والصلاحيات الآتية:"@ar ;
    dzdoc:targetDocumentUri "https://legal.dz/resource/constitution/2020-12-30/1"^^xsd:anyURI .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_93_obligation_0_f9316104_ref_f0049a66f9c7> a dzdoc:ExternalReference,
        dzdoc:Reference ;
    rdfs:label "الدستور"@ar ;
    dzdoc:frbrUri "/akn/dz/act/constitution/2020-12-30/1"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/constitution/2020-12-30/1"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/constitution/2020-12-30/1" ;
    dzdoc:referencesTarget <https://legal.dz/resource/constitution/2020-12-30/1> ;
    dzdoc:resolutionReason "canonical_akn_path" ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceEId "art_93" ;
    dzdoc:sourceElementType "obligation" ;
    dzdoc:sourceTextSpan "لا يجوز، بأي حال من الأحوال، أن يفوض رئيس الجمهورية سلطته في تعيين الوزير الأول أو رئيس الحكومة وأعضاء الحكومة وكذا رؤساء المؤسسات الدستورية وأعضائها الذين لم ينص الدستور على طريقة أخرى لتعيينهم."@ar ;
    dzdoc:targetDocumentUri "https://legal.dz/resource/constitution/2020-12-30/1"^^xsd:anyURI .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_93_obligation_1_1b734b6e_ref_f0049a66f9c7> a dzdoc:ExternalReference,
        dzdoc:Reference ;
    rdfs:label "الدستور"@ar ;
    dzdoc:frbrUri "/akn/dz/act/constitution/2020-12-30/1"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/constitution/2020-12-30/1"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/constitution/2020-12-30/1" ;
    dzdoc:referencesTarget <https://legal.dz/resource/constitution/2020-12-30/1> ;
    dzdoc:resolutionReason "canonical_akn_path" ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceEId "art_93" ;
    dzdoc:sourceElementType "obligation" ;
    dzdoc:sourceTextSpan "لا يجوز أن يفوض سلطته في اللجوء إلى الاستفتاء وحل المجلس الشعبي الوطني، وتقرير إجراء الانتخابات التشريعية قبل أوانها، وتطبيق الأحكام المنصوص عليها في المواد 91 و92 ومن 97 إلى 100 و102 و142 و 148 و 149 و 150 من الدستور."@ar ;
    dzdoc:targetDocumentUri "https://legal.dz/resource/constitution/2020-12-30/1"^^xsd:anyURI .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_94_obligation_2_067921dd_ref_093486239f5f> a dzdoc:ExternalReference,
        dzdoc:Reference ;
    rdfs:label "المادة 96 من الدستور"@ar ;
    dzdoc:frbrUri "/akn/dz/act/constitution/2020-12-30#art_96"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/constitution/2020-12-30#art_96"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/constitution/2020-12-30/#art_96" ;
    dzdoc:resolutionReason "non_canonical_or_malformed_akn_uri" ;
    dzdoc:resolutionStatus "unresolved" ;
    dzdoc:sourceEId "art_94" ;
    dzdoc:sourceElementType "obligation" ;
    dzdoc:sourceTextSpan "يكلف بتولي رئاسة الدولة بالنيابة مدة أقصاها خمسة وأربعون (45) يوما، رئيس مجلس الأمة الذي يمارس صلاحياته مع مراعاة أحكام المادة 96 من الدستور"@ar ;
    dzdoc:targetEId "art_96" .

