    dznorm:provisionText "لا يحق لرئيس الدولة المعين بهذه الطريقة أن يترشح لرئاسة الجمهورية"@ar ;
    dznorm:sourceArticle "art_94" .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_94_obligation_8_39fea8d5> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/constitution/2020-11-01/2020#art_94> ;
