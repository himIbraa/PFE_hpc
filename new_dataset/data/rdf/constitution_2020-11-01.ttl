        <https://legal.dz/resource/constitution/2020-11-01/2020#art_76_para_1>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_76_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_76_20201101_OpEnact_8dd2b90771> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-11-01/2020#art_76_obligation_0_784c9b78> ;
