    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "المادة 175" ;
    dzdoc:position 172 .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_177> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثالث__تنظيم_السلطات_والفصل_بينها_sec_الرابع__القضاء> ;
    dzdoc:eId "art_177" ;
    dzdoc:fullText "يحق للمتقاضي المطالبة بحقوقه أمام الجهات القضائية ، و يمكنه أن يستعين بمحام خلال كل الإجراءات القضائية ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-11-01/2020#art_177_right_0_728ae41f>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_177_right_1_964921ea> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_177> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_177_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_177_20201101_OpEnact_28f3deb02c> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "المادة 177" ;
    dzdoc:position 174 ;
    dzdoc:usesTerm dzterm:lawyer,
        dzterm:litigant .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_178> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثالث__تنظيم_السلطات_والفصل_بينها_sec_الرابع__القضاء> ;
    dzdoc:eId "art_178" ;
    dzdoc:fullText "كل أجهزة الدولة المختصة مطالبة في كل وقت وفي كل مكان، وفي جميع الظروف، بالسهر على تنفيذ أحكام القضاء . يعاقب القانون كل من يمس باستقلالية القاضي ، أو يعرقل حسن سير العدالة وتنفيذ قراراتها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_178> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_178_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_178_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_178_20201101_OpEnact_34235b17b1> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-11-01/2020#art_178_obligation_0_32da9c21> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "المادة 178" ;
    dzdoc:position 175 ;
    dzdoc:usesTerm dzterm:judge,
        dzterm:judiciary .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_182> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثالث__تنظيم_السلطات_والفصل_بينها_sec_الرابع__القضاء> ;
    dzdoc:eId "art_182" ;
    dzdoc:fullText "يبدي المجلس الأعلى للقضاء رأيا استشاريا قبليا في ممارسة رئيس الجمهورية حق العفو."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_182> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_182_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_182_20201101_OpEnact_42421f8498> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-11-01/2020#art_182_obligation_0_1abd92b9> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "182" ;
    dzdoc:position 179 ;
    dzdoc:usesTerm dzterm:supreme_council_judiciary .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_194> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الرابع__مؤسسات_الرقابة_sec_الأول__المحكمة_الدستورية> ;
    dzdoc:eId "art_194" ;
    dzdoc:fullText "تتداول المحكمة الدستورية في جلسة مغلقة، وتصدر قرارها في ظرف ثلاثين (30) يوما من تاريخ إخطارها. وفي حال وجود طارئ، وبطلب من رئيس الجمهورية، يخفض هذا الأجل إلى عشرة (10) أيام."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_194> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_194_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_194_20201101_OpEnact_fa2a5e9403> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "المادة 194" ;
    dzdoc:position 190 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/2020-11-01/2020#art_194_condition_0_7eddc573> ;
    dzdoc:usesTerm dzterm:constitutional_court .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_20> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:definesTerm dzterm:public_property ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثالث__الدولة> ;
    dzdoc:eId "art_20" ;
    dzdoc:fullText "الملكية العامة هي ملك المجموعة الوطنية. وتشمل باطن الأرض، والمناجم، والمقالع، والموارد الطبيعية للطاقة، والثروات المعدنية الطبيعية والحية، في مختلف مناطق الأملاك الوطنية البحرية، والمياه، والغابات. كما تشمل النقل بالسكك الحديدية، والنقل البحري والجوي، والبريد والمواصلات السلكية واللاسلكية، وأملاكا أخرى محددة في القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_20> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/constitution/2020-11-01/2020#art_20_defocc_fa4c8c6e7818> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_20_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_20_para_1>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_20_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_20_20201101_OpEnact_f88fc69bae> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "المادة 20" ;
    dzdoc:position 19 .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_201> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الرابع__مؤسسات_الرقابة_sec_الثالث__السلطة_الوطنية_المستقلة_للإنتخابات> ;
    dzdoc:eId "art_201" ;
    dzdoc:fullText "يعين رئيس الجمهورية رئيس السلطة الوطنية المستقلة للانتخابات وأعضاءها، لعهدة واحدة (1) مدتها ست (6) سنوات غير قابلة للتجديد. يشترط في أعضاء السلطة الوطنية المستقلة للانتخابات عدم الانتماء إلى أي حزب سياسي . يحدد القانون العضوي المتعلق بنظام الانتخابات قواعد تنظيم السلطة الوطنية المستقلة للانتخابات وسيرها وصلاحياتها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_201> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_201_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_201_para_1>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_201_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_201_20201101_OpEnact_29f0972d23> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "المادة 201" ;
    dzdoc:position 197 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/2020-11-01/2020#art_201_condition_0_4e4bbfe2> ;
    dzdoc:usesTerm dzterm:independent_authority_for_elections,
        dzterm:president .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_214> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:definesTerm dzterm:high_youth_council ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الخامس__الهيئات_الاستشارية> ;
    dzdoc:eId "art_214" ;
    dzdoc:fullText "المجلس الأعلى للشباب هيئة استشارية لدى رئيس الجمهورية . يضم المجلس الأعلى للشباب ممثلين عن الشباب وممثلين عن الحكومة وعن المؤسسات العمومية المكلفة بشؤون الشباب. يحدد رئيس الجمهورية تشكيلة المجلس ومهامه الأخرى."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_214> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/constitution/2020-11-01/2020#art_214_defocc_e154357cda72> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_214_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_214_para_1>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_214_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_214_20201101_OpEnact_cd7f336d0c> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "المادة 214" ;
    dzdoc:position 209 ;
    dzdoc:usesTerm dzterm:high_youth_council,
        dzterm:president .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_223> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_السادس__التعديل_الدستوري> ;
    dzdoc:eId "art_223" ;
    dzdoc:fullText "لا يمكن أي تعديل دستوري أن يمس: الطابع الجمهوري للدولة، النظام الديمقراطي القائم على التعددية الحزبية، الطابع الاجتماعي للدولة، الإسلام باعتباره دين الدولة، العربية باعتبارها اللغة الوطنية والرسمية، تمازيغت كلغة وطنية ورسمية. الحريات الأساسية وحقوق الإنسان والمواطن، سلامة التراب الوطني ووحدته، العلم الوطني والنشيد الوطني باعتبارهما من رموز ثورة نوفمبر 1954 المجيدة والجمهورية والأمة، عدم جواز تولي أكثر من عهدتين رئاسيتين متتاليتين أو منفصلتين ومدة كل عهدة خمس (5) سنوات"@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/2020-11-01/2020#art_223_permission_0_0b12b73c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_223> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_223_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_223_20201101_OpEnact_c147e5b7e9> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "المادة 223" ;
    dzdoc:position 218 .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_35> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثاني__الحقوق_الأساسية_والحريات_العامة_والواجبات_sec_الأول__الحقوق_الأساسية_و_الحريات_العامة> ;
    dzdoc:eId "art_35" ;
    dzdoc:fullText "تضمن الدولة الحقوق الأساسية والحريات . تستهدف مؤسسات الجمهورية ضمان مساواة كل المواطنين والمواطنات في الحقوق والواجبات بإزالة العقبات التي تعوق تفتح شخصية الإنسان، وتحول دون المشاركة الفعلية للجميع في الحياة السياسية، والاقتصادية، والاجتماعية، والثقافية."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-11-01/2020#art_35_right_0_e5e91dd8> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_35> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_35_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_35_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_35_20201101_OpEnact_0a75a0c933> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-11-01/2020#art_35_obligation_0_585ec4f5> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "35" ;
    dzdoc:position 34 .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_37> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثاني__الحقوق_الأساسية_والحريات_العامة_والواجبات_sec_الأول__الحقوق_الأساسية_و_الحريات_العامة> ;
    dzdoc:eId "art_37" ;
    dzdoc:fullText "كل المواطنين سواسية أمام القانون، ولهم الحق في حماية متساوية . ولا يمكن أن يتذرع بأي تمييز يعود سببه إلى المولد، أو العرق، أو الجنس، أو الرأي، أو أي شرط أو ظرف آخر، شخصي أو اجتماعي."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/2020-11-01/2020#art_37_permission_0_e442e017> ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-11-01/2020#art_37_right_0_04da27ce> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_37> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_37_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_37_20201101_OpEnact_e1fbea281e> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "37" ;
    dzdoc:position 36 .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_62> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثاني__الحقوق_الأساسية_والحريات_العامة_والواجبات_sec_الأول__الحقوق_الأساسية_و_الحريات_العامة> ;
    dzdoc:eId "art_62" ;
    dzdoc:fullText "تعمل السلطات العمومية على حماية المستهلكين ، بشكل يضمن لهم الأمن والسلامة والصحة وحقوقهم الاقتصادية ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-11-01/2020#art_62_right_0_1236854c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_62> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_62_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_62_20201101_OpEnact_daa216bb64> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-11-01/2020#art_62_obligation_0_de3ba812> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "62" ;
    dzdoc:position 61 .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_64> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثاني__الحقوق_الأساسية_والحريات_العامة_والواجبات_sec_الأول__الحقوق_الأساسية_و_الحريات_العامة> ;
    dzdoc:eId "art_64" ;
    dzdoc:fullText "للمواطن الحق في بيئة سليمة في إطار التنمية المستدامة . يحدد القانون واجبات الأشخاص الطبيعيين والمعنويين لحماية البيئة ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-11-01/2020#art_64_right_0_2beae0ab> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_64> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_64_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_64_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_64_20201101_OpEnact_7d5330a152> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-11-01/2020#art_64_obligation_0_538b98c0> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "64" ;
    dzdoc:position 63 .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_72> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثاني__الحقوق_الأساسية_والحريات_العامة_والواجبات_sec_الأول__الحقوق_الأساسية_و_الحريات_العامة> ;
    dzdoc:eId "art_72" ;
    dzdoc:fullText "تعمل الدولة على ضمان إدماج الفئات المحرومة ذات الاحتياجات الخاصة في الحياة الاجتماعية . يحدد القانون شروط وكيفيات تطبيق هذا الحكم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_72> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_72_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_72_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_72_20201101_OpEnact_0c50dc605b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-11-01/2020#art_72_obligation_0_47513f0f> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "المادة 72" ;
    dzdoc:position 71 .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_8> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثاني__الشعب> ;
    dzdoc:eId "art_8" ;
    dzdoc:fullText "السلطة التأسيسية ملك للشعب . يمارس الشعب سيادته بواسطة المؤسسات الدستورية التي يختارها. يمارس الشعب هذه السيادة أيضا عن طريق الاستفتاء وبواسطة ممثليه المنتخبين. لـ رئيس الجمهورية أن يلتجئ إلى إرادة الشعب مباشرة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_8> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_8_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_8_para_1>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_8_para_2>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_8_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_8_20201101_OpEnact_252bbe43d9> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "8" ;
    dzdoc:position 7 ;
    dzdoc:usesTerm dzterm:constituent_power,
        dzterm:constitutional_institutions,
        dzterm:people,
        dzterm:president,
        dzterm:referendum .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_81> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثاني__الحقوق_الأساسية_والحريات_العامة_والواجبات_sec_الثاني__الواجبات> ;
    dzdoc:eId "art_81" ;
    dzdoc:fullText "يمارس كل شخص جميع الحريات في إطار احترام الحقوق المعترف بها للغير في الدستور ، لاسيما منها احترام الحق في الشرف، والحياة الخاصة، وحماية الأسرة والطفولة والشباب ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-11-01/2020#art_81_right_0_9d4accc3> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_81> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_81_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_81_20201101_OpEnact_496a4b8f94> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-11-01/2020#art_81_obligation_0_7f772293>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_81_obligation_1_de6dc975> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "81" ;
    dzdoc:position 80 ;
    dzdoc:references <https://legal.dz/resource/constitution/2020-11-01/2020#constitution> ;
    dzdoc:referencesInternal <https://legal.dz/resource/constitution/2020-11-01/2020#constitution> .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_83> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثاني__الحقوق_الأساسية_والحريات_العامة_والواجبات_sec_الثاني__الواجبات> ;
    dzdoc:eId "art_83" ;
    dzdoc:fullText "يجب على كل مواطن أن يحمي الملكية العامة ومصالح المجموعة الوطنية، وأن يحترم ملكية الغير"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_83> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_83_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_83_20201101_OpEnact_dcbc3fba7e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-11-01/2020#art_83_obligation_0_9cd2a0a9> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "83" ;
    dzdoc:position 82 .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_89> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثالث__تنظيم_السلطات_والفصل_بينها_sec_الأول__رئيس_الجمهورية> ;
    dzdoc:eId "art_89" ;
    dzdoc:fullText "يؤدي رئيس الجمهورية اليمين أمام الشعب بحضور جميع الهيئات العليا في الأمة خلال الأسبوع الموالي لانتخابه. ويباشر مهمته فور أدائه اليمين."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_89> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_89_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_89_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_89_20201101_OpEnact_1baa923cec> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-11-01/2020#art_89_obligation_0_02210546> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "المادة 89" ;
    dzdoc:position 88 ;
    dzdoc:usesTerm dzterm:president .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_103> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثالث__تنظيم_السلطات_والفصل_بينها_sec_الثاني__الحكومة> ;
    dzdoc:eId "art_103" ;
    dzdoc:fullText "في حال أسفرت الانتخابات التشريعية عن أغلبية رئاسية ، يقود الحكومة وزير أول . في حال أسفرت الانتخابات التشريعية عن أغلبية برلمانية ، يقود الحكومة رئيس حكومة . تتكون الحكومة من الوزير الأول أو رئيس الحكومة ، حسب الحالة، ومن الوزراء الذين يشكلونها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_103> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_103_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_103_para_1>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_103_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_103_20201101_OpEnact_8ddd1da2f6> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "المادة 103" ;
    dzdoc:position 102 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/2020-11-01/2020#art_103_condition_0_5e5d3373>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_103_condition_1_de6c8ca9> ;
    dzdoc:usesTerm dzterm:government,
        dzterm:head_of_government,
        dzterm:ministers,
        dzterm:prime_minister .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_108> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثالث__تنظيم_السلطات_والفصل_بينها_sec_الثاني__الحكومة> ;
    dzdoc:eId "art_108" ;
    dzdoc:fullText "إذا لم تحصل موافقة المجلس الشعبي الوطني من جديد ، يحل وجوبا. تستمر الحكومة القائمة في تسيير الشؤون العادية إلى غاية انتخاب المجلس الشعبي الوطني وذلك في أجل أقصاه ثلاثة (3) أشهر."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_108> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_108_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_108_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_108_20201101_OpEnact_d13ec9d9db> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "المادة 108" ;
    dzdoc:position 107 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/2020-11-01/2020#art_108_condition_0_4f143889> ;
    dzdoc:usesTerm dzterm:government,
        dzterm:national_peoples_assembly .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_125> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثالث__تنظيم_السلطات_والفصل_بينها_sec_الثالث__البرلمان> ;
    dzdoc:eId "art_125" ;
    dzdoc:fullText "عهدة النائب وعضو مجلس الأمة وطنية، و لا يمكن الجمع بينها وبين عهدات أو وظائف أخرى ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/2020-11-01/2020#art_125_permission_0_3c292a4e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_125> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_125_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_125_20201101_OpEnact_91d1bcbe16> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-11-01/2020#art_125_obligation_0_4811fdef> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "125" ;
    dzdoc:position 124 ;
    dzdoc:usesTerm dzterm:council_of_nation .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_135> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثالث__تنظيم_السلطات_والفصل_بينها_sec_الثالث__البرلمان> ;
    dzdoc:eId "art_135" ;
    dzdoc:fullText "يحدد قانون عضوي تنظيم المجلس الشعبي الوطني و مجلس الأمة ، وعملهما، وكذا العلاقات الوظيفية بينهما وبين الحكومة . يحدد القانون ميزانية الغرفتين. يعد كل من المجلس الشعبي الوطني و مجلس الأمة نظامه الداخلي ويصادق عليه"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_135> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_135_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_135_para_1>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_135_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_135_20201101_OpEnact_069ecf4e21> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "المادة 135" ;
    dzdoc:position 133 ;
    dzdoc:usesTerm dzterm:apn,
        dzterm:council_of_nation,
        dzterm:government .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_140> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثالث__تنظيم_السلطات_والفصل_بينها_sec_الثالث__البرلمان> ;
    dzdoc:eId "art_140" ;
    dzdoc:fullText "إضافة إلى المجالات المخصصة للقوانين العضوية بموجب الدستور ، يشرع البرلمان بقوانين عضوية في المجالات الآتية : تنظيم السلطات العمومية، وعملها، نظام الانتخابات، القانون المتعلق بالأحزاب السياسية، القانون المتعلق بالإعلام، القانون الأساسي للقضاء، والتنظيم القضائي، القانون المتعلق بقوانين المالية. تتم المصادقة على القانون العضوي بالأغلبية المطلقة للنواب ولأعضاء مجلس الأمة . يخضع القانون العضوي، قبل إصداره، لمراقبة مطابقته للدستور من طرف المحكمة الدستورية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_140> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_140_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_140_para_1>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_140_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_140_20201101_OpEnact_9d02639c8b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-11-01/2020#art_140_obligation_0_a1b998f4>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_140_obligation_1_5fa1b06e> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "140" ;
    dzdoc:position 138 ;
    dzdoc:usesTerm dzterm:constitution,
        dzterm:constitutional_court,
        dzterm:council_of_nation,
        dzterm:parliament .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_143> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثالث__تنظيم_السلطات_والفصل_بينها_sec_الثالث__البرلمان> ;
    dzdoc:eId "art_143" ;
    dzdoc:fullText "لكل من الوزير الأول أو رئيس الحكومة ، حسب الحالة، والنواب وأعضاء مجلس الأمة، حق المبادرة بالقوانين . تعرض مشاريع القوانين على مجلس الوزراء، بعد رأي مجلس الدولة، ثم يودعها الوزير الأول أو رئيس الحكومة ، حسب الحالة، لدى مكتب المجلس الشعبي الوطني أو مكتب مجلس الأمة ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-11-01/2020#art_143_right_0_0651a21d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_143> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_143_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_143_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_143_20201101_OpEnact_e3e07317a0> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-11-01/2020#art_143_obligation_0_c23c2265> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "المادة 143" ;
    dzdoc:position 141 ;
    dzdoc:usesTerm dzterm:head_of_government,
        dzterm:prime_minister .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_157> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثالث__تنظيم_السلطات_والفصل_بينها_sec_الثالث__البرلمان> ;
    dzdoc:eId "art_157" ;
    dzdoc:fullText "يمكن للجان البرلمانية سماع أعضاء الحكومة حول كل مسألة تتعلق بالمصلحة العامة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/2020-11-01/2020#art_157_permission_0_28e6b74f> ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-11-01/2020#art_157_right_0_df5742a1> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_157> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_157_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_157_20201101_OpEnact_d72bab9651> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "157" ;
    dzdoc:position 154 ;
    dzdoc:usesTerm dzterm:government .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_16> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثالث__الدولة> ;
    dzdoc:eId "art_16" ;
    dzdoc:fullText "تقوم الدولة على مبدئ التمثيل الديمقراطي، والفصل بين السلطات، وضمان الحقوق والحريات و العدالة الاجتماعية . المجلس المنتخب هو الإطار الذي يعبر فيه الشعب عن إرادته، ويراقب عمل السلطات العمومية. تشجع الدولة الديمقراطية التشاركية على مستوى الجماعات المحلية ، لاسيما من خلال المجتمع المدني."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-11-01/2020#art_16_right_0_a73f839e>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_16_right_1_40df4243> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_16> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_16_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_16_para_1>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_16_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_16_20201101_OpEnact_5ddbabb695> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "المادة 16" ;
    dzdoc:position 15 ;
    dzdoc:usesTerm dzterm:elected_council,
        dzterm:local_communities,
        dzterm:state .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_170> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثالث__تنظيم_السلطات_والفصل_بينها_sec_الرابع__القضاء> ;
    dzdoc:eId "art_170" ;
    dzdoc:fullText "يمكن أن يساعد القضاة ، في ممارسة مهامهم القضائية، مساعدون شعبيون وفق الشروط التي يحددها القانون ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/2020-11-01/2020#art_170_permission_0_b16beff1> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_170> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_170_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_170_20201101_OpEnact_eb86695825> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "المادة 170" ;
    dzdoc:position 167 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/2020-11-01/2020#art_170_condition_0_31cad45b> ;
    dzdoc:usesTerm dzterm:judge .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_171> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثالث__تنظيم_السلطات_والفصل_بينها_sec_الرابع__القضاء> ;
    dzdoc:eId "art_171" ;
    dzdoc:fullText "يلتزم القاضي في ممارسة وظيفته بتطبيق المعاهدات المصادق عليها، وقوانين الجمهورية وكذا قرارات المحكمة الدستورية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_171> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_171_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_171_20201101_OpEnact_f573db59a2> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-11-01/2020#art_171_obligation_0_ead3a0ff> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "المادة 171" ;
    dzdoc:position 168 ;
    dzdoc:usesTerm dzterm:judge .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_188> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الرابع__مؤسسات_الرقابة_sec_الأول__المحكمة_الدستورية> ;
    dzdoc:eId "art_188" ;
    dzdoc:fullText "يعين رئيس الجمهورية رئيس المحكمة الدستورية لعهدة واحدة مدتها ست (6) سنوات، على أن تتوفر فيه الشروط المنصوص عليها في المادة 87 من الدستور باستثناء شرط السن . يضطلع أعضاء المحكمة الدستورية بمهامهم مرة واحدة مدتها ست (6) سنوات، ويجدد نصف عدد أعضاء المحكمة الدستورية كل ثلاث (3) سنوات. يحدد النظام الداخلي للمحكمة الدستورية شروط وكيفيات التجديد الجزئي."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_188> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_188_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_188_para_1>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_188_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_188_20201101_OpEnact_eea46969fb> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "188" ;
    dzdoc:position 184 ;
    dzdoc:references <https://legal.dz/resource/constitution/2020-11-01/2020#art_87> ;
    dzdoc:referencesInternal <https://legal.dz/resource/constitution/2020-11-01/2020#art_87> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/2020-11-01/2020#art_188_condition_0_9a122baf> ;
    dzdoc:usesTerm dzterm:constitutional_court .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_202> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الرابع__مؤسسات_الرقابة_sec_الثالث__السلطة_الوطنية_المستقلة_للإنتخابات> ;
    dzdoc:eId "art_202" ;
    dzdoc:fullText "تتولى السلطة الوطنية المستقلة للانتخابات مهمة تحضير وتنظيم وتسيير الانتخابات الرئاسية والتشريعية والمحلية وعمليات الاستفتاء والإشراف عليها. تمارس السلطة الوطنية المستقلة للانتخابات عمليات التسجيل في القوائم الانتخابية ومراجعتها، وعمليات تحضير العملية الانتخابية، وعمليات التصويت والفرز والبت في النزاعات الانتخابية حسب التشريع الساري المفعول. تمارس السلطة الوطنية المستقلة للانتخابات مهامها منذ تاريخ استدعاء الهيئة الانتخابية حتى إعلان النتائج المؤقتة للاقتراع. تمارس السلطة الوطنية المستقلة للانتخابات مهامها في شفافية وحياد وعدم تحيز ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_202> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_202_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_202_para_1>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_202_para_2>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_202_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_202_20201101_OpEnact_593ca7b8b5> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-11-01/2020#art_202_obligation_0_807913b7> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "المادة 202" ;
    dzdoc:position 198 ;
    dzdoc:usesTerm dzterm:independent_authority_for_elections .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_213> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:definesTerm dzterm:onsc ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الخامس__الهيئات_الاستشارية> ;
    dzdoc:eId "art_213" ;
    dzdoc:fullText "المرصد الوطني للمجتمع المدني هيئة استشارية لدى رئيس الجمهورية . يقدم المرصد آراء وتوصيات متعلقة بانشغالات المجتمع المدني. يساهم المرصد في ترقية القيم الوطنية والممارسة الديمقراطية والمواطنة ويشارك مع المؤسسات الأخرى في تحقيق أهداف التنمية الوطنية. يحدد رئيس الجمهورية تشكيلة المرصد ومهامه الأخرى."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_213> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/constitution/2020-11-01/2020#art_213_defocc_cf3f3dc64fbf> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_213_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_213_para_1>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_213_para_2>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_213_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_213_20201101_OpEnact_47d09422bb> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "213" ;
    dzdoc:position 208 ;
    dzdoc:usesTerm dzterm:president .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_30> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:definesTerm dzterm:anp_mission ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثالث__الدولة> ;
    dzdoc:eId "art_30" ;
    dzdoc:fullText "تنتظم الطاقة الدفاعية للأمة، ودعمها، وتطويرها، حول الجيش الوطني الشعبي. تتمثل المهمة الدائمة للجيش الوطني الشعبي في المحافظة على الاستقلال الوطني، والدفاع عن السيادة الوطنية . كما يضطلع بالدفاع عن وحدة البلاد، وسلامتها الترابية، وحماية مجالها البري والجوي والبحري. يتولى الجيش الوطني الشعبي الدفاع عن المصالح الحيوية والاستراتيجية للبلاد طبقا لأحكام الدستور."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_30> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/constitution/2020-11-01/2020#art_30_defocc_8f1efe9f89d2> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_30_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_30_para_1>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_30_para_2>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_30_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_30_20201101_OpEnact_8cdca0cc93> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "30" ;
    dzdoc:position 29 .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_31> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثالث__الدولة> ;
    dzdoc:eId "art_31" ;
    dzdoc:fullText "تمتنع الجزائر عن اللجوء إلى الحرب من أجل المساس بالسيادة المشروعة للشعوب الأخرى وحريتها. تبذل الجزائر جهدها لتسوية الخلافات الدولية بالوسائل السلمية. يمكن للجزائر، في إطار احترام مبادئ وأهداف الأمم المتحدة والاتحاد الإفريقي وجامعة الدول العربية، أن تشارك في حفظ السلم."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/2020-11-01/2020#art_31_permission_0_213bfe98> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_31> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_31_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_31_para_1>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_31_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_31_20201101_OpEnact_a466898857> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "31" ;
    dzdoc:position 30 .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_38> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثاني__الحقوق_الأساسية_والحريات_العامة_والواجبات_sec_الأول__الحقوق_الأساسية_و_الحريات_العامة> ;
    dzdoc:eId "art_38" ;
    dzdoc:fullText "الحق في الحياة لصيق بالإنسان، يحميه القانون، ولا يمكن أن يحرم أحد منه إلا في الحالات التي يحددها القانون ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/2020-11-01/2020#art_38_permission_0_375fa243> ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-11-01/2020#art_38_right_0_792b9ad7> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_38> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_38_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_38_20201101_OpEnact_0312debad7> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "38" ;
    dzdoc:position 37 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/2020-11-01/2020#art_38_condition_0_1e3964d6> .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_52> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثاني__الحقوق_الأساسية_والحريات_العامة_والواجبات_sec_الأول__الحقوق_الأساسية_و_الحريات_العامة> ;
    dzdoc:eId "art_52" ;
    dzdoc:fullText "حرية التعبير مضمونة . حرية الاجتماع وحرية التظاهر السلمي مضمونتان، وتمارسان بمجرد التصريح بهما . يحدد القانون شروط وكيفيات ممارستها."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-11-01/2020#art_52_right_0_384f0c39>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_52_right_1_19b0e732> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_52> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_52_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_52_para_1>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_52_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_52_20201101_OpEnact_ce6fe1e525> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "52" ;
    dzdoc:position 51 .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_67> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثاني__الحقوق_الأساسية_والحريات_العامة_والواجبات_sec_الأول__الحقوق_الأساسية_و_الحريات_العامة> ;
    dzdoc:eId "art_67" ;
    dzdoc:fullText "يتساوى جميع المواطنين في تقلد المهام والوظائف في الدولة ، باستثناء المهام والوظائف ذات الصلة بالسيادة والأمن الوطنيين . يحدد القانون شروط تطبيق هذا الحكم ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-11-01/2020#art_67_right_0_9b39a61d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_67> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_67_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_67_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_67_20201101_OpEnact_803c3c90e2> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "67" ;
    dzdoc:position 66 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/2020-11-01/2020#art_67_condition_0_5b151503>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_67_condition_1_f4947ee2> .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_68> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثاني__الحقوق_الأساسية_والحريات_العامة_والواجبات_sec_الأول__الحقوق_الأساسية_و_الحريات_العامة> ;
    dzdoc:eId "art_68" ;
    dzdoc:fullText "تعمل الدولة على ترقية التناصف بين الرجال والنساء في سوق التشغيل . تشجع الدولة ترقية المرأة في مناصب المسؤولية في الهيئات والإدارات العمومية وعلى مستوى المؤسسات."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_68> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_68_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_68_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_68_20201101_OpEnact_4c37deabb9> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-11-01/2020#art_68_obligation_0_9ba04d52>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_68_obligation_1_3f7f68fa> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "68" ;
    dzdoc:position 67 .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_69> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثاني__الحقوق_الأساسية_والحريات_العامة_والواجبات_sec_الأول__الحقوق_الأساسية_و_الحريات_العامة> ;
    dzdoc:eId "art_69" ;
    dzdoc:fullText "الحق النقابي مضمون ، ويمارس بكل حرية في إطار القانون. يمكن لمتعاملي القطاع الاقتصادي أن ينتظموا ضمن منظمات أرباب العمل في إطار احترام القانون."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/2020-11-01/2020#art_69_permission_0_5d4b4267> ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-11-01/2020#art_69_right_0_2c8680aa> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_69> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_69_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_69_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_69_20201101_OpEnact_3f7c5effd3> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "69" ;
    dzdoc:position 68 .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_75> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثاني__الحقوق_الأساسية_والحريات_العامة_والواجبات_sec_الأول__الحقوق_الأساسية_و_الحريات_العامة> ;
    dzdoc:eId "art_75" ;
    dzdoc:fullText "الحريات الأكاديمية وحرية البحث العلمي مضمونة . تعمل الدولة على ترقية البحث العلمي وتثمينه خدمة للتنمية المستدامة للأمة ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-11-01/2020#art_75_right_0_754d851f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_75> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_75_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_75_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_75_20201101_OpEnact_94010f36b0> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-11-01/2020#art_75_obligation_0_f72dc2b5> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "المادة 75" ;
    dzdoc:position 74 .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_79> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثاني__الحقوق_الأساسية_والحريات_العامة_والواجبات_sec_الثاني__الواجبات> ;
    dzdoc:eId "art_79" ;
    dzdoc:fullText "يجب على كل مواطن أن يحمي ويصون استقلال البلاد وسيادتها وسلامة ترابها الوطني ووحدة شعبها وجميع رموز الدولة . يعاقب القانون بكل صرامة على الخيانة والتجسس والولاء للعدو، وعلى جميع الجرائم المرتكبة ضد أمن الدولة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_79> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_79_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_79_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_79_20201101_OpEnact_662b980ccf> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-11-01/2020#art_79_obligation_0_7ca07c71> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "79" ;
    dzdoc:position 78 .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_85> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثالث__تنظيم_السلطات_والفصل_بينها_sec_الأول__رئيس_الجمهورية> ;
    dzdoc:eId "art_85" ;
    dzdoc:fullText "ينتخب رئيس الجمهورية عن طريق الاقتراع العام المباشر والسري. يتم الفوز في الانتخاب بالحصول على الأغلبية المطلقة من أصوات الناخبين المعبر عنها. يحدد قانون عضوي كيفيات تطبيق أحكام هذه المادة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_85> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_85_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_85_para_1>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_85_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_85_20201101_OpEnact_251e0057ea> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "المادة 85" ;
    dzdoc:position 84 ;
    dzdoc:references <https://legal.dz/resource/constitution/2020-11-01/2020#art_85> ;
    dzdoc:referencesInternal <https://legal.dz/resource/constitution/2020-11-01/2020#art_85> ;
    dzdoc:usesTerm dzterm:president .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_104> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثالث__تنظيم_السلطات_والفصل_بينها_sec_الثاني__الحكومة> ;
    dzdoc:eId "art_104" ;
    dzdoc:fullText "يعين رئيس الجمهورية أعضاء الحكومة بناء على اقتراح من الوزير الأول أو رئيس الحكومة ، حسب الحالة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_104> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_104_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_104_20201101_OpEnact_437436e207> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "المادة 104" ;
    dzdoc:position 103 ;
    dzdoc:usesTerm dzterm:government,
        dzterm:head_of_government,
        dzterm:president,
        dzterm:prime_minister .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_107> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثالث__تنظيم_السلطات_والفصل_بينها_sec_الثاني__الحكومة> ;
    dzdoc:eId "art_107" ;
    dzdoc:fullText "يقدم الوزير الأول استقالة الحكومة لرئيس الجمهورية في حالة عدم موافقة المجلس الشعبي الوطني على مخطط عمل الحكومة . يعين رئيس الجمهورية من جديد وزيرا أول حسب الكيفيات نفسها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_107> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_107_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_107_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_107_20201101_OpEnact_6b836cbbb3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-11-01/2020#art_107_obligation_0_d2ed97d5> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "المادة 107" ;
    dzdoc:position 106 ;
    dzdoc:usesTerm dzterm:government,
        dzterm:national_peoples_assembly,
        dzterm:president,
        dzterm:prime_minister .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_110> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثالث__تنظيم_السلطات_والفصل_بينها_sec_الثاني__الحكومة> ;
    dzdoc:eId "art_110" ;
    dzdoc:fullText "إذا أسفرت الانتخابات التشريعية عن أغلبية برلمانية غير الأغلبية الرئاسية ، يعين رئيس الجمهورية رئيس الحكومة من الأغلبية البرلمانية، ويكلفه بتشكيل حكومته وإعداد برنامج الأغلبية البرلمانية. إذا لم يصل رئيس الحكومة المعين إلى تشكيل حكومته في أجل ثلاثين (30) يوما ، يعين رئيس الجمهورية رئيس حكومة جديدا ويكلفه بتشكيل الحكومة . يعرض رئيس الحكومة ، في كل الحالات، برنامج حكومته على مجلس الوزراء ، ثم يقدمه للبرلمان حسب الشروط المنصوص عليها في المواد 106 (الفقرات الأولى و3 و 4) و 107 و 108 ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_110> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_110_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_110_para_1>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_110_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_110_20201101_OpEnact_6eb06ce941> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "المادة 110" ;
    dzdoc:position 109 ;
    dzdoc:references <https://legal.dz/resource/constitution/2020-11-01/2020#art_106>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_107>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_108> ;
    dzdoc:referencesInternal <https://legal.dz/resource/constitution/2020-11-01/2020#art_106>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_107>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_108> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/2020-11-01/2020#art_110_condition_0_9d9b1029>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_110_condition_1_755ac4c4> ;
    dzdoc:usesTerm dzterm:council_of_ministers,
        dzterm:government,
        dzterm:head_of_government,
        dzterm:parliament,
        dzterm:president .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_165> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثالث__تنظيم_السلطات_والفصل_بينها_sec_الرابع__القضاء> ;
    dzdoc:eId "art_165" ;
    dzdoc:fullText "يقوم القضاء على أساس مبادئ الشرعية والمساواة. القضاء متاح للجميع . يضمن القانون التقاضي على درجتين ، و يحدد شروط و إجراءات تطبيقه."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-11-01/2020#art_165_right_0_11bee078> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_165> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_165_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_165_para_1>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_165_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_165_20201101_OpEnact_d0f9070724> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-11-01/2020#art_165_obligation_0_afd56090> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "المادة 165" ;
    dzdoc:position 162 ;
    dzdoc:usesTerm dzterm:judiciary .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_187> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الرابع__مؤسسات_الرقابة_sec_الأول__المحكمة_الدستورية> ;
    dzdoc:eId "art_187" ;
    dzdoc:fullText "يشترط في عضو المحكمة الدستورية المنتخب أو المعين : بلوغ خمسين (50) سنة كاملة يوم انتخابه أو تعيينه، التمتع بخبرة في القانون لا تقل عن عشرين (20) سنة، واستفاد من تكوين في القانون الدستوري، التمتع بالحقوق المدنية والسياسية، وألا يكون محكوما عليه بعقوبة سالبة للحرية، عدم الانتماء الحزبي. بمجرد انتخاب أعضاء المحكمة الدستورية أو تعيينهم ، يتوقفون عن ممارسة أي عضوية أو أي وظيفة أو تكليف أو مهمة أخرى، أو أي نشاط آخر أو مهنة حرة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_187> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_187_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_187_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_187_20201101_OpEnact_135e2beb60> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-11-01/2020#art_187_obligation_0_7eb0533e> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "187" ;
    dzdoc:position 183 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/2020-11-01/2020#art_187_condition_0_6b53f4da> ;
    dzdoc:usesTerm dzterm:constitutional_court .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_192> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الرابع__مؤسسات_الرقابة_sec_الأول__المحكمة_الدستورية> ;
    dzdoc:eId "art_192" ;
    dzdoc:fullText "يمكن إخطار المحكمة الدستورية من طرف الجهات المحددة في المادة 193 أدناه، بشأن الخلافات التي قد تحدث بين السلطات الدستورية. يمكن لهذه الجهات إخطار المحكمة الدستورية حول تفسير حكم أو عدة أحكام دستورية، وتبدي المحكمة الدستورية رأيا بشأنها."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/2020-11-01/2020#art_192_permission_0_37389625>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_192_permission_1_3b3a8ddf> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_192> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_192_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_192_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_192_20201101_OpEnact_f7a8c13d15> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "المادة 192" ;
    dzdoc:position 188 ;
    dzdoc:references <https://legal.dz/resource/constitution/2020-11-01/2020#art_193> ;
    dzdoc:referencesInternal <https://legal.dz/resource/constitution/2020-11-01/2020#art_193> ;
    dzdoc:usesTerm dzterm:constitutional_court .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_26> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثالث__الدولة> ;
    dzdoc:eId "art_26" ;
    dzdoc:fullText "الإدارة في خدمة المواطن. يضمن القانون عدم تحيز الإدارة. تلزم الإدارة برد معلل في أجل معقول بشأن الطلبات التي تستوجب إصدار قرار إداري . تتعامل الإدارة بكل حياد مع الجمهور في إطار احترام الشرعية، وأداء الخدمة بدون تماطل."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_26> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_26_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_26_para_1>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_26_para_2>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_26_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_26_20201101_OpEnact_8cd3aab0a7> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-11-01/2020#art_26_obligation_0_9f18784e> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "26" ;
    dzdoc:position 25 .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_27> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثالث__الدولة> ;
    dzdoc:eId "art_27" ;
    dzdoc:fullText "تضمن المرافق العمومية لكل مرتفق التساوي في الحصول على الخدمات، وبدون تمييز . تقوم المرافق العمومية على مبادئ الاستمرارية، والتكيف المستمر، والتغطية المنصفة للتراب الوطني، وعند الاقتضاء، ضمان حد أدنى من الخدمة."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-11-01/2020#art_27_right_0_e84afa81> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_27> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_27_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_27_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_27_20201101_OpEnact_427ba67bec> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-11-01/2020#art_27_obligation_0_62ffc9b1> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "27" ;
    dzdoc:position 26 .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_29> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثالث__الدولة> ;
    dzdoc:eId "art_29" ;
    dzdoc:fullText "تعمل الدولة على حماية حقوق المواطنين في الخارج ومصالحهم ، في ظل احترام القانون الدولي والاتفاقيات المبرمة مع بلدان الاستقبال أو بلدان الإقامة. تسهر الدولة على الحفاظ على هوية وكرامة المواطنين المقيمين في الخارج وتعزيز روابطهم مع الأمة، وتعبئة مساهماتهم في تنمية بلدهم الأصلي ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_29> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_29_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_29_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_29_20201101_OpEnact_e36dad14b2> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-11-01/2020#art_29_obligation_0_3d99a6bc>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_29_obligation_1_aa836a16> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "29" ;
    dzdoc:position 28 .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_39> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثاني__الحقوق_الأساسية_والحريات_العامة_والواجبات_sec_الأول__الحقوق_الأساسية_و_الحريات_العامة> ;
    dzdoc:eId "art_39" ;
    dzdoc:fullText "تضمن الدولة عدم انتهاك حرمة الإنسان . يحظر أي عنف بدني أو معنوي، أو أي مساس بالكرامة. يعاقب القانون على التعذيب، وعلى المعاملات القاسية، واللاإنسانية أو المهينة، والاتجار بالبشر."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_39> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_39_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_39_para_1>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_39_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_39_20201101_OpEnact_87cc581dc0> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-11-01/2020#art_39_obligation_0_6ae6c4df> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/constitution/2020-11-01/2020#art_39_prohibition_0_5d893f41> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "39" ;
    dzdoc:position 38 .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_44> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثاني__الحقوق_الأساسية_والحريات_العامة_والواجبات_sec_الأول__الحقوق_الأساسية_و_الحريات_العامة> ;
    dzdoc:eId "art_44" ;
    dzdoc:fullText "لا يتابع أحد، ولا يوقف أو يحتجز، إلا ضمن الشروط المحددة بالقانون، وطبقا للأشكال التي نص عليها . يتعين إعلام كل شخص موقوف بأسباب توقيفه . الحبس المؤقت إجراء استثنائي، يحدد القانون أسبابه ومدته وشروط تمديده. يعاقب القانون على أعمال وأفعال الاعتقال التعسفي."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_44> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_44_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_44_para_1>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_44_para_2>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_44_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_44_20201101_OpEnact_e6402354ec> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-11-01/2020#art_44_obligation_0_e09e7b5c> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "44" ;
    dzdoc:position 43 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/2020-11-01/2020#art_44_condition_0_57c989d3> .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_48> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثاني__الحقوق_الأساسية_والحريات_العامة_والواجبات_sec_الأول__الحقوق_الأساسية_و_الحريات_العامة> ;
    dzdoc:eId "art_48" ;
    dzdoc:fullText "تضمن الدولة عدم انتهاك حرمة المسكن . لا تفتيش إلا بمقتضى القانون، وفي إطار احترامه . لا تفتيش إلا بأمر مكتوب صادر عن السلطة القضائية المختصة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_48> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_48_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_48_para_1>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_48_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_48_20201101_OpEnact_e0d4a7b2ba> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-11-01/2020#art_48_obligation_0_dad5edad> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "48" ;
    dzdoc:position 47 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/2020-11-01/2020#art_48_condition_0_75b6506e>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_48_condition_1_c78f244f> .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_53> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثاني__الحقوق_الأساسية_والحريات_العامة_والواجبات_sec_الأول__الحقوق_الأساسية_و_الحريات_العامة> ;
    dzdoc:eId "art_53" ;
    dzdoc:fullText "حق إنشاء الجمعيات مضمون، ويمارس بمجرد التصريح به . تشجع الدولة الجمعيات ذات المنفعة العامة. يحدد قانون عضوي شروط وكيفيات إنشاء الجمعيات. لا تحل الجمعيات إلا بمقتضى قرار قضائي ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-11-01/2020#art_53_right_0_b67a49af> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_53> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_53_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_53_para_1>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_53_para_2>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_53_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_53_20201101_OpEnact_b4f5ca3cd0> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "53" ;
    dzdoc:position 52 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/2020-11-01/2020#art_53_condition_0_9c8ea46b> .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_59> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثاني__الحقوق_الأساسية_والحريات_العامة_والواجبات_sec_الأول__الحقوق_الأساسية_و_الحريات_العامة> ;
    dzdoc:eId "art_59" ;
    dzdoc:fullText "تعمل الدولة على ترقية الحقوق السياسية للمرأة بتوسيع حظوظ تمثيلها في المجالس المنتخبة . يحدد قانون عضوي شروط تطبيق هذا الحكم ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-11-01/2020#art_59_right_0_731fdc6d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_59> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_59_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_59_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_59_20201101_OpEnact_2ac4cfc514> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-11-01/2020#art_59_obligation_0_882f5011> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "59" ;
    dzdoc:position 58 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/2020-11-01/2020#art_59_condition_0_f4947ee2> ;
    dzdoc:usesTerm dzterm:organic_law .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_77> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثاني__الحقوق_الأساسية_والحريات_العامة_والواجبات_sec_الأول__الحقوق_الأساسية_و_الحريات_العامة> ;
    dzdoc:eId "art_77" ;
    dzdoc:fullText "لكل مواطن الحق في تقديم ملتمسات إلى الإدارة، بشكل فردي أو جماعي، لطرح انشغالات تتعلق بالمصلحة العامة أو بتصرفات ماسة بحقوقه الأساسية . يتعين على الإدارة المعنية الرد على الملتمسات في أجل معقول"@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-11-01/2020#art_77_right_0_774d99cb> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_77> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_77_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_77_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_77_20201101_OpEnact_60014ea6e5> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-11-01/2020#art_77_obligation_0_dd31e671> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "المادة 77" ;
    dzdoc:position 76 .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_118> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثالث__تنظيم_السلطات_والفصل_بينها_sec_الثالث__البرلمان> ;
    dzdoc:eId "art_118" ;
    dzdoc:fullText "يتفرغ النائب أو عضو مجلس الأمة كليا لممارسة عهدته . ينص النظام الداخلي لكل من المجلس الشعبي الوطني و مجلس الأمة على أحكام تتعلق بـ وجوب المشاركة الفعلية لأعضائهما في أشغال اللجان وفي الجلسات العامة ، تحت طائلة العقوبات المطبقة في حالة الغياب. تصوت كل غرفة من غرفتي البرلمان على القوانين واللوائح بحضور أغلبية أعضائها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_118> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_118_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_118_para_1>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_118_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_118_20201101_OpEnact_680bf0499f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-11-01/2020#art_118_obligation_0_480fbdb1>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_118_obligation_1_11f0b8b9> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "المادة 118" ;
    dzdoc:position 117 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/2020-11-01/2020#art_118_condition_0_2d7d454d> ;
    dzdoc:usesTerm dzterm:apn,
        dzterm:internal_rules,
        dzterm:senate .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_120> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثالث__تنظيم_السلطات_والفصل_بينها_sec_الثالث__البرلمان> ;
    dzdoc:eId "art_120" ;
    dzdoc:fullText "يجرد المنتخب في المجلس الشعبي الوطني أو في مجلس الأمة، المنتمي إلى حزب سياسي، الذي يغير طوعا الانتماء الذي انتخب على أساسه، من عهدته الانتخابية بقوة القانون . تعلن المحكمة الدستورية شغور المقعد بعد إخطارها وجوبا من رئيس الغرفة المعنية . ويحدد قانون عضوي كيفيات استخلافه. يحتفظ النائب الذي استقال من حزبه أو أبعد منه بعهدته بصفة نائب غير منتم ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-11-01/2020#art_120_right_0_06498075> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_120> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_120_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_120_para_1>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_120_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_120_20201101_OpEnact_d9fbab886c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-11-01/2020#art_120_obligation_0_2980b816>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_120_obligation_1_099b9d5c> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "المادة 120" ;
    dzdoc:position 119 .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_137> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثالث__تنظيم_السلطات_والفصل_بينها_sec_الثالث__البرلمان> ;
    dzdoc:eId "art_137" ;
    dzdoc:fullText "يشكل كل من المجلس الشعبي الوطني و مجلس الأمة لجانه الدائمة في إطار نظامه الداخلي. يمكن كل لجنة دائمة من لجان الغرفتين تشكيل بعثة استعلام مؤقتة حول موضوع محدد أو وضع معين . يحدد النظام الداخلي لكل غرفة من الغرفتين الأحكام التي تخضع لها البعثة الاستعلامية."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/2020-11-01/2020#art_137_permission_0_22c2e3fe> ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-11-01/2020#art_137_right_0_c70bea35> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_137> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_137_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_137_para_1>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_137_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_137_20201101_OpEnact_aeb082921a> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "المادة 137" ;
    dzdoc:position 135 ;
    dzdoc:usesTerm dzterm:apn,
        dzterm:council_of_nation .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_146> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثالث__تنظيم_السلطات_والفصل_بينها_sec_الثالث__البرلمان> ;
    dzdoc:eId "art_146" ;
    dzdoc:fullText "يصادق البرلمان على قانون المالية في مدة أقصاها خمسة وسبعون (75) يوما من تاريخ إيداعه . في حالة عدم المصادقة عليه في الأجل المحدد سابقا ، يصدر رئيس الجمهورية مشروع الحكومة بأمر . تحدد الإجراءات الأخرى بموجب القانون العضوي المذكور في المادة 135 من الدستور."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_146> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_146_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_146_para_1>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_146_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_146_20201101_OpEnact_586b589672> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-11-01/2020#art_146_obligation_0_4dd670a9>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_146_obligation_1_e9fef7fa> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "المادة 146" ;
    dzdoc:position 143 ;
    dzdoc:references <https://legal.dz/resource/constitution/2020-11-01/2020#art_135> ;
    dzdoc:referencesInternal <https://legal.dz/resource/constitution/2020-11-01/2020#art_135> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/2020-11-01/2020#art_146_condition_0_eaf30b43> ;
    dzdoc:usesTerm dzterm:finance_law,
        dzterm:organic_law,
        dzterm:parliament,
        dzterm:president .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_15> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثالث__الدولة> ;
    dzdoc:eId "art_15" ;
    dzdoc:fullText "لا يجوز البتة التنازل أو التخلي عن أي جزء من التراب الوطني."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/2020-11-01/2020#art_15_permission_0_a02260ac> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_15> ;
