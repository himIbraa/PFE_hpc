<https://legal.dz/resource/constitution/2020-11-01/2020#version_art_142> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ل رئيس الجمهورية أن يشرع بأوامر في مسائل عاجلة في حالة شغور المجلس الشعبي الوطني أو خلال العطلة البرلمانية بعد رأي مجلس الدولة. يخطر رئيس الجمهورية وجوبا المحكمة الدستورية بشأن دستورية هذه الأوامر ، على أن تفصل فيها في أجل أقصاه عشرة (10) أيام. يعرض رئيس الجمهورية الأوامر التي اتخذها على كل غرفة من البرلمان في بداية الدورة القادمة لتوافق عليها . تعد لاغية الأوامر التي لا يوافق عليها البرلمان. يمكن رئيس الجمهورية أن يشرع بأوامر في الحالة الاستثنائية المذكورة في المادة 98 من الدستور . تتخذ الأوامر"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_142_20201101_OpEnact_c26985f456> ;
    dzdoc:replacementText "ل رئيس الجمهورية أن يشرع بأوامر في مسائل عاجلة في حالة شغور المجلس الشعبي الوطني أو خلال العطلة البرلمانية بعد رأي مجلس الدولة. يخطر رئيس الجمهورية وجوبا المحكمة الدستورية بشأن دستورية هذه الأوامر ، على أن تفصل فيها في أجل أقصاه عشرة (10) أيام. يعرض رئيس الجمهورية الأوامر التي اتخذها على كل غرفة من البرلمان في بداية الدورة القادمة لتوافق عليها . تعد لاغية الأوامر التي لا يوافق عليها البرلمان. يمكن رئيس الجمهورية أن يشرع بأوامر في الحالة الاستثنائية المذكورة في المادة 98 من الدستور . تتخذ الأوامر في مجلس الوزراء."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/constitution/2020-11-01/2020#art_142> ;
    dzdoc:sourceDocument <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:targetArticle <https://legal.dz/resource/constitution/2020-11-01/2020#art_142> ;
    dzdoc:targetDocument <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2020-11-01"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/constitution/2020-11-01/2020#version_art_143> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لكل من الوزير الأول أو رئيس الحكومة ، حسب الحالة، والنواب وأعضاء مجلس الأمة، حق المبادرة بالقوانين . تعرض مشاريع القوانين على مجلس الوزراء، بعد رأي مجلس الدولة، ثم يودعها الوزير الأول أو رئيس الحكومة ، حسب الحالة، لدى مكتب المجلس الشعبي الوطني أو مكتب مجلس الأمة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_143_20201101_OpEnact_e3e07317a0> ;
    dzdoc:replacementText "لكل من الوزير الأول أو رئيس الحكومة ، حسب الحالة، والنواب وأعضاء مجلس الأمة، حق المبادرة بالقوانين . تعرض مشاريع القوانين على مجلس الوزراء، بعد رأي مجلس الدولة، ثم يودعها الوزير الأول أو رئيس الحكومة ، حسب الحالة، لدى مكتب المجلس الشعبي الوطني أو مكتب مجلس الأمة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/constitution/2020-11-01/2020#art_143> ;
