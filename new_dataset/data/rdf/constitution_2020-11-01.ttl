<https://legal.dz/resource/constitution/2020-11-01/2020#art_66> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثاني__الحقوق_الأساسية_والحريات_العامة_والواجبات_sec_الأول__الحقوق_الأساسية_و_الحريات_العامة> ;
    dzdoc:eId "art_66" ;
    dzdoc:fullText "العمل حق و واجب . كل عمل يقابله أجر . ضمن القانون أثناء العمل الحق في الحماية، والأمن، والنظافة . الحق في الراحة مضمون ، ويحدد القانون شروط ممارسته. يضمن القانون حق العامل في الضمان الاجتماعي . يعاقب القانون على تشغيل الأطفال. تعمل الدولة على ترقية التمهين وتضع سياسات للمساعدة على استحداث مناصب الشغل . يحدد القانون شروط تسخير المستخدمين لأغراض المصلحة العامة ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-11-01/2020#art_66_right_0_e5bc45d8>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_66_right_1_5c4ba0b8>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_66_right_2_36fc38c2>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_66_right_3_7815f69d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_66> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_66_para_0>,
