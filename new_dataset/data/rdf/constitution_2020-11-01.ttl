<https://legal.dz/resource/constitution/2020-11-01/2020#version_art_100_20201101_OpEnact_28bd6a5eff> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2020-11-01"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_100> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/2020-11-01/2020#art_100> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/2020-11-01/2020#art_100> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:versionText "إذا وقع عدوان فعلي على البلاد أو يوشك أن يقع حسبما نصت عليه الترتيبات الملائمة لميثاق الأمم المتحدة ، يعلن رئيس الجمهورية الحرب، بعد اجتماع مجلس الوزراء والاستماع إلى المجلس الأعلى للأمن واستشارة رئيس مجلس الأمة ورئيس المجلس الشعبي الوطني ورئيس المحكمة الدستورية . يجتمع البرلمان وجوبا. يوجه رئيس الجمهورية خطابا للأمة يعلمها بذلك."@ar .

