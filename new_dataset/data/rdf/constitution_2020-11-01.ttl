<https://legal.dz/resource/constitution/2020-11-01/2020#art_142> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثالث__تنظيم_السلطات_والفصل_بينها_sec_الثالث__البرلمان> ;
    dzdoc:eId "art_142" ;
    dzdoc:fullText "ل رئيس الجمهورية أن يشرع بأوامر في مسائل عاجلة في حالة شغور المجلس الشعبي الوطني أو خلال العطلة البرلمانية بعد رأي مجلس الدولة. يخطر رئيس الجمهورية وجوبا المحكمة الدستورية بشأن دستورية هذه الأوامر ، على أن تفصل فيها في أجل أقصاه عشرة (10) أيام. يعرض رئيس الجمهورية الأوامر التي اتخذها على كل غرفة من البرلمان في بداية الدورة القادمة لتوافق عليها . تعد لاغية الأوامر التي لا يوافق عليها البرلمان. يمكن رئيس الجمهورية أن يشرع بأوامر في الحالة الاستثنائية المذكورة في المادة 98 من الدستور . تتخذ الأوامر في مجلس الوزراء."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/2020-11-01/2020#art_142_permission_0_91dd9528> ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-11-01/2020#art_142_right_0_15e0183a>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_142_right_1_b6021936> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_142> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_142_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_142_para_1>,
