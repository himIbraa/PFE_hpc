<https://legal.dz/resource/constitution/2020-11-01/2020#art_199_defocc_08e5a1ca3663> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 71 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:court_of_accounts ;
