    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:versionText "يحمي القضاء المجتمع وحريات وحقوق المواطنين طبقا للدستور."@ar .

<https://legal.dz/resource/constitution/2020-11-01/2020#version_art_165_20201101_OpEnact_d0f9070724> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
