<https://legal.dz/resource/constitution/2020-11-01/2020#art_153_obligation_0_17c7aae8> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasRole <https://legal.dz/resource/constitution/2020-11-01/2020#art_153_obligation_0_17c7aae8_role_533c64c9fe> ;
    dznorm:expressedIn <https://legal.dz/resource/constitution/2020-11-01/2020#art_153> ;
    dznorm:hasCondition <https://legal.dz/resource/constitution/2020-11-01/2020#art_153_obligation_0_17c7aae8_condition_0> ;
    dznorm:position 0 ;
    dznorm:provisionText "يصادق رئيس الجمهورية على اتفاقيات الهدنة، ومعاهدات السلم، والتحالف والاتحاد، والمعاهدات المتعلقة بحدود الدولة والمعاهدات المتعلقة بقانون الأشخاص، والمعاهدات التي تترتب عليها نفقات غير واردة في ميزانية الدولة، والاتفاقات الثنائية أو المتعددة الأطراف المتعلقة بمناطق التبادل الحر والشراكة وبالتكامل الاقتصادي، بعد أن توافق عليها كل غرفة من البرلمان صراحة"@ar ;
    dznorm:sourceArticle "art_153" .

