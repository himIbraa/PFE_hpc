<https://legal.dz/resource/constitution/2020-11-01/2020#version_art_31> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تمتنع الجزائر عن اللجوء إلى الحرب من أجل المساس بالسيادة المشروعة للشعوب الأخرى وحريتها. تبذل الجزائر جهدها لتسوية الخلافات الدولية بالوسائل السلمية. يمكن للجزائر، في إطار احترام مبادئ وأهداف الأمم المتحدة والاتحاد الإفريقي وجامعة الدول العربية، أن تشارك في حفظ السلم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_31_20201101_OpEnact_a466898857> ;
