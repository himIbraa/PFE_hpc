<https://legal.dz/resource/constitution/2020-11-01/2020#art_91_obligation_0_9f44794b> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasReference <https://legal.dz/resource/constitution/2020-11-01/2020#art_91_obligation_0_9f44794b_ref_f0049a66f9c7> ;
    dzdoc:referencesExternal <https://legal.dz/resource/constitution/2020-11-01/2020#art_91_obligation_0_9f44794b_ref_f0049a66f9c7> ;
    dznorm:expressedIn <https://legal.dz/resource/constitution/2020-11-01/2020#art_91> ;
    dznorm:position 0 ;
    dznorm:provisionText "يضطلع رئيس الجمهورية، بالإضافة إلى السلطات التي تخولها إياه صراحة أحكام أخرى في الدستور، بالسلطات والصلاحيات الآتية:"@ar ;
    dznorm:sourceArticle "art_91" .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_91_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#art_91> ;
    dzdoc:position 0 ;
    dzdoc:text "يضطلع رئيس الجمهورية، بالإضافة إلى السلطات التي تخولها إياه صراحة أحكام أخرى في الدستور، بالسلطات والصلاحيات الآتية: 1) هو القائد الأعلى للقوات المسلحة للجمهورية، ويتولى مسؤولية الدفاع الوطني، 2) يقرر إرسال وحدات من الجيش الوطني الشعبي إلى خارج الوطن بعد مصادقة البرلمان بأغلبية ثلثي (3/2) أعضاء كل غرفة من غرفتي البرلمان، 3) يقرر السياسة الخارجية للأمة ويوجهها، 4) يرأس مجلس الوزراء، 5) يعين الوزير الأول أو رئيس الحكومة، حسب الحالة، وينهي مهامه، 6) يتولى السلطة التنظيمية، 7) يوقع المراسيم الرئاسية، 8) له حق إصدار العفو وحق تخفيض العقوبات أو استبدالها، 9) يمكنه أن يستشير الشعب في كل قضية ذات أهمية وطنية عن طريق الاستفتاء، 10) يستدعي الهيئة الناخبة، 11) يمكن أن يقرر إجراء انتخابات رئاسية مسبقة، 12) يبرم المعاهدات الدولية ويصادق عليها، 13) يسلم أوسمة الدولة ونياشينها وشهاداتها التشريفية."@ar .

