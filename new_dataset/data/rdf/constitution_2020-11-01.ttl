    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_209_20201101_OpEnact_56adacbd8f> ;
    dzdoc:replacementText "المجلس الوطني الاقتصادي والاجتماعي والبيئي ، إطار للحوار والتشاور والاقتراح والاستشراف والتحليل في المجالات الاقتصادية والاجتماعية والبيئية، يوضع لدى رئيس الجمهورية . وهو كذلك مستشار الحكومة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
