<https://legal.dz/resource/constitution/2020-11-01/2020#art_119> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثالث__تنظيم_السلطات_والفصل_بينها_sec_الثالث__البرلمان> ;
    dzdoc:eId "art_119" ;
    dzdoc:fullText "يمكن للحكومة أن تطلب من البرلمان المصادقة على مشاريع القوانين حسب إجراء الاستعجال . يحدد قانون عضوي شروط وكيفيات تطبيق هذا الحكم."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/2020-11-01/2020#art_119_permission_0_a10283b2> ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-11-01/2020#art_119_right_0_84b8a6f1> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_119> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_119_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_119_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_119_20201101_OpEnact_4f41df10be> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "المادة 119" ;
    dzdoc:position 118 .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_131> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثالث__تنظيم_السلطات_والفصل_بينها_sec_الثالث__البرلمان> ;
    dzdoc:eId "art_131" ;
    dzdoc:fullText "في حالة تلبس أحد النواب أو أحد أعضاء مجلس الأمة بجنحة أو جناية ، يمكن توقيفه، ويخطر بذلك مكتب المجلس الشعبي الوطني ، أو مكتب مجلس الأمة ، حسب الحالة، فورا. يمكن المكتب المخطر أن يطلب إيقاف المتابعة وإطلاق سراح النائب أو عضو مجلس الأمة ، على أن يعمل فيما بعد بأحكام المادة 130 أعلاه."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/2020-11-01/2020#art_131_permission_0_2465574e>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_131_permission_1_1a226f47> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_131> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_131_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_131_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_131_20201101_OpEnact_30798f0194> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "131" ;
    dzdoc:position 130 ;
    dzdoc:references <https://legal.dz/resource/constitution/2020-11-01/2020#art_130> ;
    dzdoc:referencesInternal <https://legal.dz/resource/constitution/2020-11-01/2020#art_130> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/2020-11-01/2020#art_131_condition_0_69fbc225> ;
    dzdoc:usesTerm dzterm:council_of_nation,
        dzterm:national_peoples_assembly .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_136> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثالث__تنظيم_السلطات_والفصل_بينها_sec_الثالث__البرلمان> ;
    dzdoc:eId "art_136" ;
    dzdoc:fullText "جلسات البرلمان علانية. تدون مداولات البرلمان في محاضر تنشر طبقا للشروط التي يحددها القانون العضوي. يمكن لكل من المجلس الشعبي الوطني و مجلس الأمة أن يعقد جلسات مغلقة بطلب من رئيسه، أو من أغلبية أعضائه الحاضرين، أو بطلب من الوزير الأول أو رئيس الحكومة ، حسب الحالة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/2020-11-01/2020#art_136_permission_0_95359a6e> ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-11-01/2020#art_136_right_0_9b88cdc1> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_136> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_136_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_136_para_1>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_136_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_136_20201101_OpEnact_6985e6bd49> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "المادة 136" ;
    dzdoc:position 134 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/2020-11-01/2020#art_136_condition_0_8982907f> ;
    dzdoc:usesTerm dzterm:apn,
        dzterm:council_of_nation,
        dzterm:head_of_government,
        dzterm:parliament,
        dzterm:prime_minister .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_3> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الأول__الجزائر> ;
    dzdoc:eId "art_3" ;
    dzdoc:fullText "اللغة العربية هي اللغة الوطنية والرسمية. تظل العربية اللغة الرسمية للدولة. يحدث لدى رئيس الجمهورية مجلس أعلى للغة العربية . يكلف المجلس الأعلى للغة العربية على الخصوص بالعمل على ازدهار اللغة العربية وتعميم استعمالها في الميادين العلمية والتكنولوجية والتشجيع على الترجمة إليها لهذه الغاية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_3> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_3_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_3_para_1>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_3_para_2>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_3_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_3_20201101_OpEnact_862d4b3b82> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-11-01/2020#art_3_obligation_0_e4e38c0d> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "المادة 3" ;
    dzdoc:position 2 ;
    dzdoc:usesTerm dzterm:arabic_language,
        dzterm:president,
        dzterm:supreme_council_arabic .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_60> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثاني__الحقوق_الأساسية_والحريات_العامة_والواجبات_sec_الأول__الحقوق_الأساسية_و_الحريات_العامة> ;
    dzdoc:eId "art_60" ;
    dzdoc:fullText "الملكية الخاصة مضمونة . لا تنزع الملكية إلا في إطار القانون، وبتعويض عادل ومنصف . حق الإرث مضمون . الأملاك الوقفية وأملاك الجمعيات الخيرية معترف بها، و يحمي القانون تخصيصها ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-11-01/2020#art_60_right_0_6421b836>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_60_right_1_51711fef> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_60> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_60_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_60_para_1>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_60_para_2>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_60_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_60_20201101_OpEnact_1a49eed1c2> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-11-01/2020#art_60_obligation_0_ed613d56> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "60" ;
    dzdoc:position 59 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/2020-11-01/2020#art_60_condition_0_c941d9bd> ;
    dzdoc:usesTerm dzterm:private_property .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_73> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثاني__الحقوق_الأساسية_والحريات_العامة_والواجبات_sec_الأول__الحقوق_الأساسية_و_الحريات_العامة> ;
    dzdoc:eId "art_73" ;
    dzdoc:fullText "تسهر الدولة على توفير الوسائل المؤسساتية والمادية الكفيلة بتنمية قدرات الشباب، وتحفيز طاقاتهم الإبداعية . تشجع الدولة الشباب على المشاركة في الحياة السياسية. تحمي الدولة الشباب من الآفات الاجتماعية. يحدد القانون شروط تطبيق هذه المادة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_73> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_73_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_73_para_1>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_73_para_2>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_73_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_73_20201101_OpEnact_5d3a4f72e5> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-11-01/2020#art_73_obligation_0_c9f8907c> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "المادة 73" ;
    dzdoc:position 72 ;
    dzdoc:references <https://legal.dz/resource/constitution/2020-11-01/2020#art_73> ;
    dzdoc:referencesInternal <https://legal.dz/resource/constitution/2020-11-01/2020#art_73> .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_78> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثاني__الحقوق_الأساسية_والحريات_العامة_والواجبات_sec_الثاني__الواجبات> ;
    dzdoc:eId "art_78" ;
    dzdoc:fullText "لا يعذر أحد بجهل القانون . لا يحتج بالقوانين والتنظيمات إلا بعد نشرها بالطرق الرسمية . يجب على كل شخص أن يحترم الدستور ، وأن يمتثل لقوانين الجمهورية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_78> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_78_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_78_para_1>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_78_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_78_20201101_OpEnact_9b282fe101> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-11-01/2020#art_78_obligation_0_13faa7c9>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_78_obligation_1_f2be8659> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "78" ;
    dzdoc:position 77 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/2020-11-01/2020#art_78_condition_0_b0714e36> ;
    dzdoc:usesTerm dzterm:constitution .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_82> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثاني__الحقوق_الأساسية_والحريات_العامة_والواجبات_sec_الثاني__الواجبات> ;
    dzdoc:eId "art_82" ;
    dzdoc:fullText "لا تحدث أية ضريبة إلا بمقتضى القانون . كل المكلفين بالضريبة متساوون أمام الضريبة، ويحدد القانون حالات وشروط الإعفاء الكلي أو الجزئي منها. الضريبة من واجبات المواطنة. لا تحدث بأثر رجعي، أية ضريبة، أو جباية، أو رسم، أو أي حق كيفما كان نوعه . كل فعل يهدف إلى التحايل على مبدأ المساواة بين المكلفين بالضريبة، يعد مساسا بمصالح المجموعة الوطنية. يعاقب القانون على التهرب والغش الضريبي."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_82> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_82_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_82_para_1>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_82_para_2>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_82_para_3>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_82_para_4>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_82_para_5> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_82_20201101_OpEnact_7dea9e2f0c> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "82" ;
    dzdoc:position 81 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/2020-11-01/2020#art_82_condition_0_fccc4c08>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_82_condition_1_2b177ff5> .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_99> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثالث__تنظيم_السلطات_والفصل_بينها_sec_الأول__رئيس_الجمهورية> ;
    dzdoc:eId "art_99" ;
    dzdoc:fullText "يقرر رئيس الجمهورية التعبئة العامة في مجلس الوزراء بعد الاستماع إلى المجلس الأعلى للأمن واستشارة رئيس مجلس الأمة ورئيس المجلس الشعبي الوطني ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_99> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_99_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_99_20201101_OpEnact_9961600785> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "المادة 99" ;
    dzdoc:position 98 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/2020-11-01/2020#art_99_condition_0_4e032a9f> .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_4> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الأول__الجزائر> ;
    dzdoc:eId "art_4" ;
    dzdoc:fullText "تمازيغت هي كذلك لغة وطنية ورسمية. تعمل الدولة لترقيتها وتطويرها بكل تنوعاتها اللسانية المستعملة عبر التراب الوطني . يحدث مجمع جزائري للغة تمازيغت يوضع لدى رئيس الجمهورية . يستند المجمع إلى أشغال الخبراء، ويكلف بتوفير الشروط اللازمة لترقية تمازيغت قصد تجسيد وضعها كلغة رسمية فيما بعد . تحدد كيفيات تطبيق هذه المادة بموجب قانون عضوي."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_4> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_4_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_4_para_1>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_4_para_2>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_4_para_3>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_4_para_4> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_4_20201101_OpEnact_122ca057af> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-11-01/2020#art_4_obligation_0_11c2d646>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_4_obligation_1_5f43e875> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "المادة 4" ;
    dzdoc:position 3 ;
    dzdoc:references <https://legal.dz/resource/constitution/2020-11-01/2020#art_4> ;
    dzdoc:referencesInternal <https://legal.dz/resource/constitution/2020-11-01/2020#art_4> ;
    dzdoc:usesTerm dzterm:academy_tamazight,
        dzterm:president,
        dzterm:tamazight_language .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_47> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثاني__الحقوق_الأساسية_والحريات_العامة_والواجبات_sec_الأول__الحقوق_الأساسية_و_الحريات_العامة> ;
    dzdoc:eId "art_47" ;
    dzdoc:fullText "لكل شخص الحق في حماية حياته الخاصة وشرفه . لكل شخص الحق في سرية مراسلاته واتصالاته الخاصة في أي شكل كانت . لا مساس بالحقوق المذكورة في الفقرتين الأولى والثانية إلا بأمر معلل من السلطة القضائية . حماية الأشخاص عند معالجة المعطيات ذات الطابع الشخصي حق أساسي . يعاقب القانون على كل انتهاك لهذه الحقوق."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-11-01/2020#art_47_right_0_fc88c4dc>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_47_right_1_b62f070f>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_47_right_2_a68c5717> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_47> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_47_para_0>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_47_para_1>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_47_para_2>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_47_para_3>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_47_para_4> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
