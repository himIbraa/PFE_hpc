    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "المادة 167" ;
    dzdoc:position 164 .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_168> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثالث__تنظيم_السلطات_والفصل_بينها_sec_الرابع__القضاء> ;
    dzdoc:eId "art_168" ;
    dzdoc:fullText "ينظر القضاء في الطعون في قرارات السلطات الإدارية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_168> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_168_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_168_20201101_OpEnact_53daaf3403> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "المادة 168" ;
    dzdoc:position 165 ;
    dzdoc:usesTerm dzterm:judiciary .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_18> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثالث__الدولة> ;
    dzdoc:eId "art_18" ;
    dzdoc:fullText "تقوم العلاقات بين الدولة و الجماعات المحلية على مبادئ اللامركزية وعدم التركيز."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_18> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_18_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_18_20201101_OpEnact_3e5ad4015c> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "المادة 18" ;
    dzdoc:position 17 ;
    dzdoc:usesTerm dzterm:local_communities,
        dzterm:state .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_19> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثالث__الدولة> ;
    dzdoc:eId "art_19" ;
    dzdoc:fullText "يمثل المجلس المنتخب قاعدة اللامركزية، ومكان مشاركة المواطنين في تسيير الشؤون العمومية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_19> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_19_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_19_20201101_OpEnact_009d44b4e0> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "المادة 19" ;
    dzdoc:position 18 ;
    dzdoc:usesTerm dzterm:elected_council .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_191> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الرابع__مؤسسات_الرقابة_sec_الأول__المحكمة_الدستورية> ;
    dzdoc:eId "art_191" ;
    dzdoc:fullText "تنظر المحكمة الدستورية في الطعون التي تتلقاها حول النتائج المؤقتة للانتخابات الرئاسية والانتخابات التشريعية والاستفتاء، وتعلن النتائج النهائية لكل هذه العمليات."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_191> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_191_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_191_20201101_OpEnact_ab7f5e64d8> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "المادة 191" ;
    dzdoc:position 187 ;
    dzdoc:usesTerm dzterm:constitutional_court .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_196> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الرابع__مؤسسات_الرقابة_sec_الأول__المحكمة_الدستورية> ;
    dzdoc:eId "art_196" ;
    dzdoc:fullText "يحدد قانون عضوي إجراءات وكيفيات الإخطار والإحالة المتبعة أمام المحكمة الدستورية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_196> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_196_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_196_20201101_OpEnact_4cf6ce7872> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "المادة 196" ;
    dzdoc:position 192 ;
    dzdoc:usesTerm dzterm:constitutional_court .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_2> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الأول__الجزائر> ;
    dzdoc:eId "art_2" ;
    dzdoc:fullText "الإسلام دين الدولة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_2> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_2_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_2_20201101_OpEnact_6ce059364f> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "المادة 2" ;
    dzdoc:position 1 ;
    dzdoc:usesTerm dzterm:islam .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_207> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الخامس__الهيئات_الاستشارية> ;
    dzdoc:eId "art_207" ;
    dzdoc:fullText "يتكون المجلس الإسلامي الأعلى من خمسة عشر (15) عضوا، منهم الرئيس، يعينهم رئيس الجمهورية من بين الكفاءات الوطنية العليا في مختلف العلوم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_207> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_207_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_207_20201101_OpEnact_7cf1c97571> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "207" ;
    dzdoc:position 202 ;
    dzdoc:usesTerm dzterm:high_islamic_council,
        dzterm:president .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_210> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الخامس__الهيئات_الاستشارية> ;
    dzdoc:eId "art_210" ;
    dzdoc:fullText "يتولى المجلس الوطني الاقتصادي والاجتماعي والبيئي ، على وجه الخصوص، مهمة: توفير إطار لمشاركة المجتمع المدني في التشاور الوطني حول سياسات التنمية الاقتصادية والاجتماعية والبيئية في إطار التنمية المستدامة، ضمان ديمومة الحوار والتشاور بين الشركاء الاقتصاديين والاجتماعيين الوطنيين، تقييم المسائل ذات المصلحة الوطنية في المجال الاقتصادي والاجتماعي والبيئي والتربوي والتكويني والتعليم العالي ودراستها، عرض اقتراحات وتوصيات على الحكومة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_210> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_210_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_210_20201101_OpEnact_dcd022e2b5> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "210" ;
    dzdoc:position 205 ;
    dzdoc:usesTerm dzterm:cnese .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_25> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثالث__الدولة> ;
    dzdoc:eId "art_25" ;
    dzdoc:fullText "يعاقب القانون على استغلال النفوذ والتعسف في استعمال السلطة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_25> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_25_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_25_20201101_OpEnact_74b354d123> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "25" ;
    dzdoc:position 24 .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_33> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثالث__الدولة> ;
    dzdoc:eId "art_33" ;
    dzdoc:fullText "تعمل الجزائر من أجل دعم التعاون الدولي، وتنمية العلاقات الودية بين الدول، على أساس المساواة، والمصلحة المتبادلة، وعدم التدخل في الشؤون الداخلية. وتتبنى مبادئ ميثاق الأمم المتحدة وأهدافه"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_33> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_33_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_33_20201101_OpEnact_a57f9fa6d2> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "33" ;
    dzdoc:position 32 .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_41> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثاني__الحقوق_الأساسية_والحريات_العامة_والواجبات_sec_الأول__الحقوق_الأساسية_و_الحريات_العامة> ;
    dzdoc:eId "art_41" ;
    dzdoc:fullText "كل شخص يعتبر بريئا حتى تثبت جهة قضائية إدانته، في إطار محاكمة عادلة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_41> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_41_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_41_20201101_OpEnact_ecdd33fd92> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "41" ;
    dzdoc:position 40 .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_43> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثاني__الحقوق_الأساسية_والحريات_العامة_والواجبات_sec_الأول__الحقوق_الأساسية_و_الحريات_العامة> ;
    dzdoc:eId "art_43" ;
    dzdoc:fullText "لا إدانة إلا بمقتضى قانون صادر قبل ارتكاب الفعل المجرم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_43> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_43_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_43_20201101_OpEnact_e57ba9436d> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "43" ;
    dzdoc:position 42 .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_5> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الأول__الجزائر> ;
    dzdoc:eId "art_5" ;
    dzdoc:fullText "عاصمة الجمهورية مدينة الجزائر."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_5> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_5_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_5_20201101_OpEnact_e82302e17e> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "المادة 5" ;
    dzdoc:position 4 .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_7> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثاني__الشعب> ;
    dzdoc:eId "art_7" ;
    dzdoc:fullText "الشعب مصدر كل سلطة. السيادة الوطنية ملك للشعب وحده."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_7> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-11-01/2020#art_7_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_7_20201101_OpEnact_433772d5d8> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:introducedOn "2020-11-01"^^xsd:date ;
    dzdoc:number "7" ;
    dzdoc:position 6 ;
    dzdoc:usesTerm dzterm:people,
        dzterm:sovereignty .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_86> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#chp_الثالث__تنظيم_السلطات_والفصل_بينها_sec_الأول__رئيس_الجمهورية> ;
    dzdoc:eId "art_86" ;
