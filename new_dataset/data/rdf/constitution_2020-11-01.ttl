<https://legal.dz/resource/constitution/2020-11-01/2020#version_art_161> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن المجلس الشعبي الوطني لدى مناقشته بيان السياسة العامة أو على إثر استجواب، أن يصوت على ملتمس رقابة ينصب على مسؤولية الحكومة . لا يقبل هذا الملتمس إلا إذا وقعه سبع (7/1) عدد النواب، على الأقل ."@ar ;
