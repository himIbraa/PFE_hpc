    dznorm:hasCondition <https://legal.dz/resource/constitution/2020-11-01/2020#art_96_obligation_3_2219cfad_condition_0> ;
    dznorm:position 3 ;
    dznorm:provisionText "لا يمكن، خلال هاتين الفترتين، تطبيق أحكام المواد 97 و 98 و 99 و 100 و 102 من الدستور إلا بموافقة البرلمان المنعقد بغرفتيه المجتمعتين معا، بعد استشارة المحكمة الدستورية والمجلس الأعلى للأمن"@ar ;
    dznorm:sourceArticle "art_96" .

