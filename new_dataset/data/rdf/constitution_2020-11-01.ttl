    dzdoc:position 0 ;
    dzdoc:text "جلسات البرلمان علانية."@ar .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_136_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#art_136> ;
    dzdoc:position 1 ;
    dzdoc:text "تدون مداولات البرلمان في محاضر تنشر طبقا للشروط التي يحددها القانون العضوي."@ar .

