    dznorm:expressedIn <https://legal.dz/resource/constitution/2020-11-01/2020#art_219> .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_219_obligation_0_1122fd51> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
