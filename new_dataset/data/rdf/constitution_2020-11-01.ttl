<https://legal.dz/resource/constitution/2020-11-01/2020#version_art_106> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يقدم الوزير الأول مخطط عمل الحكومة إلى المجلس الشعبي الوطني للموافقة عليه . ويجري المجلس الشعبي الوطني لهذا الغرض مناقشة عامة. يمكن للوزير الأول أن يكيف مخطط عمل الحكومة على ضوء مناقشة المجلس الشعبي الوطني بالتشاور مع رئيس الجمهورية . يقدم الوزير الأول عرضا حول مخطط عمل الحكومة لمجلس الأمة مثلما وافق عليه المجلس الشعبي الوطني . يمكن لمجلس الأمة ، في هذا الإطار، أن يصدر لائحة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_106_20201101_OpEnact_b63fa20964> ;
    dzdoc:replacementText "يقدم الوزير الأول مخطط عمل الحكومة إلى المجلس الشعبي الوطني للموافقة عليه . ويجري المجلس الشعبي الوطني لهذا الغرض مناقشة عامة. يمكن للوزير الأول أن يكيف مخطط عمل الحكومة على ضوء مناقشة المجلس الشعبي الوطني بالتشاور مع رئيس الجمهورية . يقدم الوزير الأول عرضا حول مخطط عمل الحكومة لمجلس الأمة مثلما وافق عليه المجلس الشعبي الوطني . يمكن لمجلس الأمة ، في هذا الإطار، أن يصدر لائحة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/constitution/2020-11-01/2020#art_106> ;
