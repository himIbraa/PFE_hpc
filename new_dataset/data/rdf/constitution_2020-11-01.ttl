<https://legal.dz/resource/constitution/2020-11-01/2020#version_art_39> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تضمن الدولة عدم انتهاك حرمة الإنسان . يحظر أي عنف بدني أو معنوي، أو أي مساس بالكرامة. يعاقب القانون على التعذيب، وعلى المعاملات القاسية، واللاإنسانية أو المهينة، والاتجار بالبشر."@ar ;
