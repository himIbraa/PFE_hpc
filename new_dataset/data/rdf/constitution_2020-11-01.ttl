<https://legal.dz/resource/constitution/2020-11-01/2020#version_art_105> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا أسفرت الانتخابات التشريعية عن أغلبية رئاسية ، يعين رئيس الجمهورية وزيرا أول ويكلفه باقتراح تشكيل الحكومة وإعداد مخطط عمل لتطبيق البرنامج الرئاسي الذي يعرضه على مجلس الوزراء ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_105_20201101_OpEnact_1e472f5425> ;
    dzdoc:replacementText "إذا أسفرت الانتخابات التشريعية عن أغلبية رئاسية ، يعين رئيس الجمهورية وزيرا أول ويكلفه باقتراح تشكيل الحكومة وإعداد مخطط عمل لتطبيق البرنامج الرئاسي الذي يعرضه على مجلس الوزراء ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
