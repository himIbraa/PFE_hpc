<https://legal.dz/resource/constitution/2020-11-01/2020#version_art_217> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتولى المجلس، على الخصوص، المهام الآتية : ترقية البحث الوطني في مجال الابتكار التكنولوجي والعلمي، اقتراح التدابير الكفيلة بتنمية القدرات الوطنية في مجال البحث والتطوير، تقييم فعالية الأجهزة الوطنية المتخصصة في تثمين نتائج البحث لفائدة الاقتصاد الوطني في إطار التنمية المستدامة. يعين رئيس الجمهورية رئيس المجلس الوطني للبحث العلمي والتكنولوجيات . يحدد القانون تنظيم المجلس وتشكيله وسيره وكذا صلاحياته."@ar ;
