<https://legal.dz/resource/constitution/2020-11-01/2020#version_art_149> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن رئيس الجمهورية أن يطلب قراءة ثانية في قانون تم التصويت عليه في غضون الثلاثين (30) يوما الموالية لتاريخ المصادقة عليه . في هذه الحالة ، لا تتم المصادقة على القانون إلا بأغلبية ثلثي (3/2) أعضاء المجلس الشعبي الوطني وأعضاء مجلس الأمة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_149_20201101_OpEnact_182c7cb92a> ;
