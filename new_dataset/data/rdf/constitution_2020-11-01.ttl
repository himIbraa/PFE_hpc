<https://legal.dz/resource/constitution/2020-11-01/2020#version_art_45> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يخضع التوقيف للنظر في مجال التحريات الجزائية للرقابة القضائية ، و لا يمكن أن يتجاوز مدة ثمان وأربعين (48) ساعة . يملك الشخص الذي يوقف للنظر حق الاتصال فورا بأسرته . يجب إعلام الشخص الذي يوقف للنظر بحقه أيضا في الاتصال بمحاميه ، و يمكن القاضي أن يحد من ممارسة هذا الحق في إطار ظروف استثنائية ينص عليها القانون . لا يمكن تمديد مدة التوقيف للنظر، إلا استثناء، ووفقا للشروط المحددة بالقانون . عند انتهاء مدة التوقيف للنظر، يجب أن يجرى فحص طبي على الشخص الموقوف، إن طلب ذلك ، على أن يعلم بهذه الإمكانية، ف"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_45_20201101_OpEnact_4c6607bdc6> ;
    dzdoc:replacementText "يخضع التوقيف للنظر في مجال التحريات الجزائية للرقابة القضائية ، و لا يمكن أن يتجاوز مدة ثمان وأربعين (48) ساعة . يملك الشخص الذي يوقف للنظر حق الاتصال فورا بأسرته . يجب إعلام الشخص الذي يوقف للنظر بحقه أيضا في الاتصال بمحاميه ، و يمكن القاضي أن يحد من ممارسة هذا الحق في إطار ظروف استثنائية ينص عليها القانون . لا يمكن تمديد مدة التوقيف للنظر، إلا استثناء، ووفقا للشروط المحددة بالقانون . عند انتهاء مدة التوقيف للنظر، يجب أن يجرى فحص طبي على الشخص الموقوف، إن طلب ذلك ، على أن يعلم بهذه الإمكانية، في كل الحالات. يخضع القصر إجباريا لفحص طبي . يحدد القانون كيفيات تطبيق هذه المادة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
