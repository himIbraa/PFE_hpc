<https://legal.dz/resource/constitution/2020-11-01/2020#art_145_obligation_1_c44e226c> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasPeriod <https://legal.dz/resource/constitution/2020-11-01/2020#art_145_obligation_1_c44e226c_period_8bd6c70fec> ;
    dznorm:expressedIn <https://legal.dz/resource/constitution/2020-11-01/2020#art_145> ;
    dznorm:position 1 ;
    dznorm:provisionText "يطلب الوزير الأول أو رئيس الحكومة، حسب الحالة، اجتماع لجنة متساوية الأعضاء تتكون من أعضاء من كلتا الغرفتين، في أجل أقصاه خمسة عشر (15) يوما، لاقتراح نص يتعلق بالأحكام محل الخلاف"@ar ;
    dznorm:sourceArticle "art_145" .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_145_obligation_1_c44e226c_period_8bd6c70fec> a dznorm:Period ;
