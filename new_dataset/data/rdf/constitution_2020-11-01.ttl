<https://legal.dz/resource/constitution/2020-11-01/2020#art_187_obligation_0_7eb0533e_condition_0> a dznorm:Condition ;
    dznorm:conditionOf <https://legal.dz/resource/constitution/2020-11-01/2020#art_187_obligation_0_7eb0533e> ;
    dznorm:conditionText "بمجرد انتخاب أعضاء المحكمة الدستورية أو تعيينهم"@ar .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_187_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-11-01/2020#art_187> ;
    dzdoc:position 0 ;
    dzdoc:text "يشترط في عضو المحكمة الدستورية المنتخب أو المعين: بلوغ خمسين (50) سنة كاملة يوم انتخابه أو تعيينه، التمتع بخبرة في القانون لا تقل عن عشرين (20) سنة، واستفاد من تكوين في القانون الدستوري، التمتع بالحقوق المدنية والسياسية، وألا يكون محكوما عليه بعقوبة سالبة للحرية، عدم الانتماء الحزبي."@ar .

