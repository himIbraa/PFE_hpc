<https://legal.dz/resource/constitution/2020-11-01/2020#version_art_210> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتولى المجلس الوطني الاقتصادي والاجتماعي والبيئي ، على وجه الخصوص، مهمة: توفير إطار لمشاركة المجتمع المدني في التشاور الوطني حول سياسات التنمية الاقتصادية والاجتماعية والبيئية في إطار التنمية المستدامة، ضمان ديمومة الحوار والتشاور بين الشركاء الاقتصاديين والاجتماعيين الوطنيين، تقييم المسائل ذات المصلحة الوطنية في المجال الاقتصادي والاجتماعي والبيئي والتربوي والتكويني والتعليم العالي ودراستها، عرض اقتراحات وتوصيات على الحكومة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_210_20201101_OpEnact_dcd022e2b5> ;
    dzdoc:replacementText "يتولى المجلس الوطني الاقتصادي والاجتماعي والبيئي ، على وجه الخصوص، مهمة: توفير إطار لمشاركة المجتمع المدني في التشاور الوطني حول سياسات التنمية الاقتصادية والاجتماعية والبيئية في إطار التنمية المستدامة، ضمان ديمومة الحوار والتشاور بين الشركاء الاقتصاديين والاجتماعيين الوطنيين، تقييم المسائل ذات المصلحة الوطنية في المجال الاقتصادي والاجتماعي والبيئي والتربوي والتكويني والتعليم العالي ودراستها، عرض اقتراحات وتوصيات على الحكومة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
