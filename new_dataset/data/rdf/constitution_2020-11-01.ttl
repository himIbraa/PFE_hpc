    dzdoc:evidenceText "إذا لم تحصل موافقة المجلس الشعبي الوطني من جديد ، يحل وجوبا. تستمر الحكومة القائمة في تسيير الشؤون العادية إلى غاية انتخاب المجلس الشعبي الوطني وذلك في أجل أقصاه ثلاثة (3) أشهر."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_108_20201101_OpEnact_d13ec9d9db> ;
