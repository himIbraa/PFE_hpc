<https://legal.dz/resource/constitution/2020-11-01/2020#version_art_102> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يوقع رئيس الجمهورية اتفاقيات الهدنة ومعاهدات السلم . يلتمس رئيس الجمهورية رأي المحكمة الدستورية بشأن الاتفاقيات المتعلقة بهما . يعرض رئيس الجمهورية تلك الاتفاقيات فورا على كل غرفة من البرلمان لتوافق عليها صراحة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_102_20201101_OpEnact_a9c8b6c87e> ;
    dzdoc:replacementText "يوقع رئيس الجمهورية اتفاقيات الهدنة ومعاهدات السلم . يلتمس رئيس الجمهورية رأي المحكمة الدستورية بشأن الاتفاقيات المتعلقة بهما . يعرض رئيس الجمهورية تلك الاتفاقيات فورا على كل غرفة من البرلمان لتوافق عليها صراحة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
