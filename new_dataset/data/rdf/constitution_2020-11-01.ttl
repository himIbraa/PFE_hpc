    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/2020-11-01/2020#art_61> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:versionText "حرية التجارة والاستثمار والمقاولة مضمونة ، وتمارس في إطار القانون."@ar .

<https://legal.dz/resource/constitution/2020-11-01/2020#version_art_62_20201101_OpEnact_daa216bb64> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2020-11-01"^^xsd:date ;
