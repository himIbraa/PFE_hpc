<https://legal.dz/resource/constitution/2020-11-01/2020#version_art_135> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يحدد قانون عضوي تنظيم المجلس الشعبي الوطني و مجلس الأمة ، وعملهما، وكذا العلاقات الوظيفية بينهما وبين الحكومة . يحدد القانون ميزانية الغرفتين. يعد كل من المجلس الشعبي الوطني و مجلس الأمة نظامه الداخلي ويصادق عليه"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_135_20201101_OpEnact_069ecf4e21> ;
