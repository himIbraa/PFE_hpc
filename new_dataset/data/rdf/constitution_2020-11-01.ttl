<https://legal.dz/resource/constitution/2020-11-01/2020#version_art_183> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تختص المحكمة العليا للدولة بالنظر في الأفعال التي يمكن تكييفها خيانة عظمى، والتي يرتكبها رئيس الجمهورية أثناء ممارسة عهدته. تختص المحكمة العليا للدولة بالنظر في الجنايات والجنح التي يرتكبها الوزير الأول ورئيس الحكومة بمناسبة تأدية مهامهما. يحدد قانون عضوي تشكيلة المحكمة العليا للدولة وتنظيمها وسيرها وكذلك الإجراءات المطبقة أمامها"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_183_20201101_OpEnact_39427fe3b1> ;
    dzdoc:replacementText "تختص المحكمة العليا للدولة بالنظر في الأفعال التي يمكن تكييفها خيانة عظمى، والتي يرتكبها رئيس الجمهورية أثناء ممارسة عهدته. تختص المحكمة العليا للدولة بالنظر في الجنايات والجنح التي يرتكبها الوزير الأول ورئيس الحكومة بمناسبة تأدية مهامهما. يحدد قانون عضوي تشكيلة المحكمة العليا للدولة وتنظيمها وسيرها وكذلك الإجراءات المطبقة أمامها"@ar ;
