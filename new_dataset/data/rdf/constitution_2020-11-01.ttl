<https://legal.dz/resource/constitution/2020-11-01/2020#version_art_24> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يحظر استحداث أي منصب عمومي أو القيام بأي طلب عمومي لا يستهدف تحقيق المصلحة العامة . لا يمكن أن تكون الوظائف والعهدات في مؤسسات الدولة مصدرا للثراء، ولا وسيلة لخدمة المصالح الخاصة. يجب على كل عون عمومي ، في إطار ممارسة مهامه، تفادي أي حالة من حالات تعارض المصالح . يجب على كل شخص يعين في وظيفة عليا في الدولة، أو ينتخب أو يعين في البرلمان، أو في هيئة وطنية، أو ينتخب في مجلس محلي، التصريح بممتلكاته في بداية وظيفته أو عهدته وفي نهايتها . يحدد القانون كيفيات تطبيق هذه الأحكام."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_24_20201101_OpEnact_20538cb646> ;
    dzdoc:replacementText "يحظر استحداث أي منصب عمومي أو القيام بأي طلب عمومي لا يستهدف تحقيق المصلحة العامة . لا يمكن أن تكون الوظائف والعهدات في مؤسسات الدولة مصدرا للثراء، ولا وسيلة لخدمة المصالح الخاصة. يجب على كل عون عمومي ، في إطار ممارسة مهامه، تفادي أي حالة من حالات تعارض المصالح . يجب على كل شخص يعين في وظيفة عليا في الدولة، أو ينتخب أو يعين في البرلمان، أو في هيئة وطنية، أو ينتخب في مجلس محلي، التصريح بممتلكاته في بداية وظيفته أو عهدته وفي نهايتها . يحدد القانون كيفيات تطبيق هذه الأحكام."@ar ;
    dzdoc:resolutionStatus "resolved" ;
