    dzdoc:position 1 ;
    dzdoc:text "تخصص كل غرفة من غرفتي البرلمان جلسة شهرية لمناقشة جدول أعمال تقدمه مجموعة أو مجموعات برلمانية من المعارضة."@ar .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_116_para_2> a dzdoc:Paragraph ;
