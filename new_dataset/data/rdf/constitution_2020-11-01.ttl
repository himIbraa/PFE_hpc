<https://legal.dz/resource/constitution/2020-11-01/2020#version_art_9> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يختار الشعب لنفسه مؤسسات، غايتها ما يأتي : المحافظة على السيادة والاستقلال الوطنيين، ودعمهما، المحافظة على الهوية والوحدة الوطنيتين، ودعمهما، حماية الحريات الأساسية للمواطن ، والازدهار الاجتماعي والثقافي للأمة، ترقية العدالة الاجتماعية، ضمان الشفافية في تسيير الشؤون العمومية، القضاء على التفاوت الجهوي في مجال التنمية، تشجيع بناء اقتصاد متنوع يثمن قدرات البلد كلها، الطبيعية والبشرية والعلمية، حماية الاقتصاد الوطني من أي شكل من أشكال التلاعب، أو الاختلاس، أو الرشوة، أو التجارة غير المشروعة، أو الت"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_9_20201101_OpEnact_3e171f5728> ;
    dzdoc:replacementText "يختار الشعب لنفسه مؤسسات، غايتها ما يأتي : المحافظة على السيادة والاستقلال الوطنيين، ودعمهما، المحافظة على الهوية والوحدة الوطنيتين، ودعمهما، حماية الحريات الأساسية للمواطن ، والازدهار الاجتماعي والثقافي للأمة، ترقية العدالة الاجتماعية، ضمان الشفافية في تسيير الشؤون العمومية، القضاء على التفاوت الجهوي في مجال التنمية، تشجيع بناء اقتصاد متنوع يثمن قدرات البلد كلها، الطبيعية والبشرية والعلمية، حماية الاقتصاد الوطني من أي شكل من أشكال التلاعب، أو الاختلاس، أو الرشوة، أو التجارة غير المشروعة، أو التعسف، أو الاستحواذ، أو المصادرة غير المشروعة أو تهريب رؤوس الأموال."@ar ;
