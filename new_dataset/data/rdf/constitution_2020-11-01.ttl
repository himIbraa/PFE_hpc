<https://legal.dz/resource/constitution/2020-11-01/2020#version_art_120> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/2020-11-01/2020> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجرد المنتخب في المجلس الشعبي الوطني أو في مجلس الأمة، المنتمي إلى حزب سياسي، الذي يغير طوعا الانتماء الذي انتخب على أساسه، من عهدته الانتخابية بقوة القانون . تعلن المحكمة الدستورية شغور المقعد بعد إخطارها وجوبا من رئيس الغرفة المعنية . ويحدد قانون عضوي كيفيات استخلافه. يحتفظ النائب الذي استقال من حزبه أو أبعد منه بعهدته بصفة نائب غير منتم ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_120_20201101_OpEnact_d9fbab886c> ;
    dzdoc:replacementText "يجرد المنتخب في المجلس الشعبي الوطني أو في مجلس الأمة، المنتمي إلى حزب سياسي، الذي يغير طوعا الانتماء الذي انتخب على أساسه، من عهدته الانتخابية بقوة القانون . تعلن المحكمة الدستورية شغور المقعد بعد إخطارها وجوبا من رئيس الغرفة المعنية . ويحدد قانون عضوي كيفيات استخلافه. يحتفظ النائب الذي استقال من حزبه أو أبعد منه بعهدته بصفة نائب غير منتم ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
