        <https://legal.dz/resource/constitution/2020-11-01/2020#art_66_para_3>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_66_para_4>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_66_para_5>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_66_para_6>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_66_para_7> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-11-01/2020#version_art_66_20201101_OpEnact_a33439a390> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-11-01/2020#art_66_obligation_0_b4e0e89e>,
        <https://legal.dz/resource/constitution/2020-11-01/2020#art_66_obligation_1_8e151702>,
