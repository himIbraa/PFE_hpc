    dzdoc:resolutionStatus "resolved" ;
    dzdoc:targetDocumentUri "https://legal.dz/resource/constitution/2020-12-30/1"^^xsd:anyURI .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_93_obligation_0_f9316104> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasReference <https://legal.dz/resource/constitution/2020-11-01/2020#art_93_obligation_0_f9316104_ref_f0049a66f9c7> ;
    dzdoc:hasRole <https://legal.dz/resource/constitution/2020-11-01/2020#art_93_obligation_0_f9316104_role_9f568dee86> ;
    dzdoc:referencesExternal <https://legal.dz/resource/constitution/2020-11-01/2020#art_93_obligation_0_f9316104_ref_f0049a66f9c7> ;
    dznorm:expressedIn <https://legal.dz/resource/constitution/2020-11-01/2020#art_93> ;
    dznorm:position 0 ;
    dznorm:provisionText "لا يجوز، بأي حال من الأحوال، أن يفوض رئيس الجمهورية سلطته في تعيين الوزير الأول أو رئيس الحكومة وأعضاء الحكومة وكذا رؤساء المؤسسات الدستورية وأعضائها الذين لم ينص الدستور على طريقة أخرى لتعيينهم."@ar ;
    dznorm:sourceArticle "art_93" .

<https://legal.dz/resource/constitution/2020-11-01/2020#art_93_obligation_0_f9316104_role_9f568dee86> a dznorm:Role ;
    rdfs:label "طريقة أخرى لتعيينهم"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
